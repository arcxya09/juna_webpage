---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { img, widths } from '../lib/img';

interface Props {
  t: Content;
}

const { history } = Astro.props.t;
---

<section class="section history" id="history">
  <div class="wrap">
    <div class="history__head">
      <div>
        <p class="kicker" data-reveal>{history.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{history.title}</h2>
      </div>
      <div class="history__ctrl" data-reveal style="--d:.16s">
        <span class="label">{history.hint}</span>
        <button type="button" class="history__btn" data-tl-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button type="button" class="history__btn" data-tl-next aria-label="Next">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="tl" data-tl>
    <ol class="tl__track" data-tl-track tabindex="0">
      {
        history.items.map((it, i) => {
          const photo = it.photo ? img(`${it.photo}.jpg`) : null;
          return (
            <li class:list={['tl__item', photo && 'has-photo', it.highlight && 'is-hl']} data-reveal style={`--d:${Math.min(i, 5) * 0.06}s`}>
              <span class="tl__dot" aria-hidden="true" />
              <div class="tl__text">
                <time class="tl__date">{it.date}</time>
                <h3 class="tl__title">{it.title}</h3>
                {it.note && <p class="tl__note">{it.note}</p>}
              </div>
              {photo && (
                <div class="tl__media">
                  <Image src={photo} alt={`${it.date} ${it.title}`} widths={widths(photo, [400, 700])} sizes="(min-width: 1441px) 20vw, 340px" loading="lazy" />
                </div>
              )}
            </li>
          );
        })
      }
    </ol>
  </div>

  <div class="wrap">
    <div class="tl__bar" aria-hidden="true"><i data-tl-progress></i></div>
  </div>
</section>

<style>
  .history {
    overflow: hidden;
  }
  .history__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .history__head .h2 {
    margin-bottom: 0;
  }
  .history__ctrl {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex: none;
  }
  .history__ctrl .label {
    margin-right: 0.625rem;
  }
  .history__btn {
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--line-strong);
    color: var(--text);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s, opacity 0.2s;
  }
  .history__btn:hover {
    border-color: var(--copper);
    color: var(--copper-light);
  }
  .history__btn:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .history__btn svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .tl__track {
    list-style: none;
    margin: 0;
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    padding: 0 0 0.5rem;
    padding-inline: var(--edge);
    scroll-padding-inline: var(--edge);
    cursor: grab;
  }
  .tl__track::-webkit-scrollbar {
    display: none;
  }
  .tl__track.is-dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .tl__item {
    position: relative;
    flex: none;
    width: 14.375rem;
    padding: 2.5rem 2rem 0 0;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
  }
  .tl__item.has-photo {
    width: 21.25rem;
  }
  .tl__item::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.5625rem;
    height: 1px;
    background: var(--line-strong);
  }
  .tl__dot {
    position: absolute;
    left: 0;
    top: 0.25rem;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    border: 1px solid var(--copper);
    background: var(--ink-900);
  }
  .is-hl .tl__dot {
    background: var(--copper);
    box-shadow: 0 0 0 0.375rem rgba(194, 124, 78, 0.18);
  }
  .tl__date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    color: var(--copper-light);
    margin-bottom: 0.5rem;
  }
  .tl__title {
    font-size: 1.125rem;
    line-height: 1.45;
    font-weight: 400;
    margin: 0;
  }
  .is-hl .tl__title {
    font-weight: 500;
  }
  .tl__note {
    margin: 0.375rem 0 0;
    font-size: 0.9062rem;
    color: var(--text-faint);
  }
  /* Items stretch to the tallest one; pushing photos to the bottom keeps
     them on one line even when a date carries an extra note. */
  .tl__text {
    padding-bottom: 1.25rem;
  }
  .tl__media {
    margin-top: auto;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-800);
  }
  .tl__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.55) contrast(1.02);
    transition: filter 0.6s, transform 1s var(--ease);
    pointer-events: none;
  }
  .tl__item:hover .tl__media img {
    filter: none;
    transform: scale(1.03);
  }
  .tl__bar {
    position: relative;
    height: 1px;
    margin-top: 2.5rem;
    background: var(--line);
  }
  .tl__bar i {
    position: absolute;
    left: 0;
    top: -1px;
    height: 0.1875rem;
    width: 100%;
    background: var(--copper);
    transform-origin: 0 50%;
    transform: scaleX(0.2);
  }
  @media (max-width: 720px) {
    .history__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .history__ctrl .label {
      display: none;
    }
    .tl__item {
      width: 12.5rem;
      padding-right: 1.5rem;
    }
    .tl__item.has-photo {
      width: 17.5rem;
    }
  }
</style>
