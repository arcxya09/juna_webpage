---
// Home: the three headline results, then an invitation to join.
import type { Content, Lang } from '../i18n/content';
import { href } from '../lib/routes';
import Reaction from './Reaction.astro';
import T from './T.astro';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const { highlights, join } = t.home;
const results = href(lang, 'results');
---

<section class="section section--rule hl">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <p class="kicker" data-reveal>{highlights.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{highlights.title}</h2>
      </div>
      <p class="hl__more" data-reveal style="--d:.16s">
        <a class="btn" href={results}>{highlights.more}</a>
      </p>
    </div>

    <div class="hl__grid">
      {
        t.results.stories.map((s, i) => (
          <a class="hl__card" href={`${results}#r-${s.id}`} data-glow data-reveal style={`--d:${i * 0.1}s`}>
            <span class="hl__i">0{i + 1}</span>
            <span class="hl__reaction">
              <Reaction text={s.reaction} />
            </span>
            <span class="hl__title">{s.title}</span>
            <span class="hl__stat">
              <span class="hl__value">
                <T s={s.stat.value} />
              </span>
              <span class="hl__label">
                <T s={s.stat.label} />
              </span>
            </span>
            <span class="hl__venue">{s.venue}</span>
          </a>
        ))
      }
    </div>

    <a class="join" href={`${href(lang, 'about')}#team`} data-reveal>
      <span class="join__title">{join.title}</span>
      <span class="join__link">
        {join.link}
        <svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 24h30M28 13l11 11-11 11"></path></svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hl__more {
    margin: 0 0 0.5rem;
    justify-self: end;
  }
  .hl__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .hl__card {
    --mx: 50%;
    --my: 0%;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    min-height: 27.5rem;
    padding: 2.25rem 2rem 2rem;
    border-right: 1px solid var(--line);
    background: radial-gradient(22.5rem circle at var(--mx) var(--my), rgba(227, 171, 128, 0.1), transparent 70%);
    background-size: 100% 100%;
    background-repeat: no-repeat;
    transition: background-color 0.4s;
  }
  .hl__card:first-child {
    border-left: 1px solid var(--line);
  }
  /* A copper rule wipes across the top of the card on hover. */
  .hl__card::before {
    content: '';
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    height: 2px;
    background: var(--copper);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease);
  }
  .hl__card:hover {
    background-color: rgba(255, 255, 255, 0.015);
  }
  .hl__card:hover::before {
    transform: scaleX(1);
  }
  .hl__i {
    font-size: 0.7812rem;
    letter-spacing: 0.16em;
    color: var(--text-faint);
  }
  .hl__reaction {
    font-size: clamp(1.5rem, 1.9vw, 1.625rem);
    font-weight: 300;
    color: var(--copper-light);
    letter-spacing: 0;
  }
  .hl__title {
    font-size: 1.1875rem;
    line-height: 1.45;
  }
  .hl__stat {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding-top: 1.75rem;
  }
  .hl__value {
    font-size: clamp(2.75rem, 3.8vw, 3.5rem);
    line-height: 1;
    font-weight: 200;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.4s;
  }
  .hl__card:hover .hl__value {
    color: var(--copper-light);
  }
  .hl__label {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .hl__venue {
    padding-top: 1.125rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .join {
    margin-top: clamp(4rem, 8vw, 7rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 3.5rem);
    border: 1px solid var(--line-strong);
    background:
      radial-gradient(80% 140% at 100% 0%, rgba(194, 124, 78, 0.22), transparent 60%),
      var(--ink-850);
    overflow: hidden;
    position: relative;
    transition: border-color 0.4s;
  }
  .join__title {
    font-size: clamp(1.5rem, 2.3vw, 2.125rem);
    line-height: 1.25;
    font-weight: 300;
    letter-spacing: -0.01em;
    max-width: 18em;
  }
  :global(html[lang='zh-CN']) .join__title {
    letter-spacing: 0.03em;
  }
  .join__link {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--copper-light);
  }
  .join__link svg {
    width: 3.5rem;
    height: 3.5rem;
    padding: 1rem;
    border: 1px solid rgba(227, 171, 128, 0.5);
    border-radius: 50%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition:
      background 0.4s,
      color 0.4s,
      transform 0.6s var(--ease);
  }
  .join:hover {
    border-color: var(--copper);
  }
  .join:hover .join__link svg {
    background: var(--copper);
    color: var(--ink-950);
    transform: translateX(0.375rem);
  }

  @media (max-width: 960px) {
    .hl__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .hl__card {
      min-height: 0;
      border-left: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 1.75rem 1.5rem;
    }
    .hl__more {
      justify-self: start;
    }
    .join {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
