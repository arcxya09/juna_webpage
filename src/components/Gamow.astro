---
import type { Content } from '../i18n/content';
import T from './T.astro';

interface Props {
  t: Content;
}

const { gamow } = Astro.props.t;

// Schematic Gamow peak: Maxwell–Boltzmann tail × tunnelling probability.
// Energies are in units of kT; b sets the Coulomb barrier strength.
const W = 640;
const H = 400;
const pad = { l: 44, r: 20, t: 28, b: 52 };
const xMax = 9;
const b = 12;
const N = 180;
const mb = (e: number) => Math.exp(-e);
const tun = (e: number) => (e <= 0 ? 0 : Math.exp(-b / Math.sqrt(e)) / Math.exp(-b / Math.sqrt(xMax)));
const es = Array.from({ length: N + 1 }, (_, i) => (i / N) * xMax);
const peakMax = Math.max(...es.map((e) => mb(e) * tun(e)));
const gam = (e: number) => ((mb(e) * tun(e)) / peakMax) * 0.58;
const e0 = Math.pow(b / 2, 2 / 3);

const sx = (e: number) => pad.l + (e / xMax) * (W - pad.l - pad.r);
const sy = (v: number) => H - pad.b - v * (H - pad.t - pad.b);
const line = (f: (e: number) => number) => es.map((e, i) => `${i ? 'L' : 'M'}${sx(e).toFixed(1)} ${sy(f(e)).toFixed(1)}`).join(' ');
const area = `${line(gam)} L${sx(xMax).toFixed(1)} ${sy(0)} L${sx(0)} ${sy(0)} Z`;
---

<section class="section section--rule gamow" id="gamow">
  <div class="wrap gamow__grid">
    <div class="gamow__text">
      <p class="kicker" data-reveal>{gamow.kicker}</p>
      <h2 class="h2" data-reveal style="--d:.08s">{gamow.title}</h2>
      {
        gamow.body.map((p, i) => (
          <p class="prose" data-reveal style={`--d:${0.14 + i * 0.06}s`}>
            {p}
          </p>
        ))
      }
      <div class="gamow__fact" data-reveal style="--d:.3s">
        <span class="gamow__value"><T s={gamow.fact.value} /></span>
        <span class="gamow__label"><T s={gamow.fact.label} /></span>
      </div>
    </div>

    <figure class="gamow__chart" data-reveal="fade">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${gamow.chart.peak}: ${gamow.chart.mb} × ${gamow.chart.tunnel}`}>
        <defs>
          <linearGradient id="gamow-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c27c4e" stop-opacity="0.55"></stop>
            <stop offset="1" stop-color="#c27c4e" stop-opacity="0.04"></stop>
          </linearGradient>
        </defs>
        <g class="grid">
          {[0.25, 0.5, 0.75, 1].map((v) => <line x1={pad.l} x2={W - pad.r} y1={sy(v)} y2={sy(v)} />)}
        </g>
        <line class="axis" x1={pad.l} x2={W - pad.r} y1={sy(0)} y2={sy(0)}></line>
        <line class="axis" x1={pad.l} x2={pad.l} y1={pad.t - 8} y2={sy(0)}></line>

        <path class="peak-area" d={area}></path>
        <line class="e0" x1={sx(e0)} x2={sx(e0)} y1={sy(0)} y2={sy(0.72)}></line>
        <path class="curve curve--mb draw" d={line(mb)} pathLength="1"></path>
        <path class="curve curve--tun draw" d={line(tun)} pathLength="1"></path>
        <path class="curve curve--peak draw" d={line(gam)} pathLength="1"></path>

        <text class="t t--mb" x={sx(0.55)} y={sy(0.62)}>{gamow.chart.mb}</text>
        <text class="t t--tun" x={sx(xMax) - 4} y={sy(0.9)} text-anchor="end">{gamow.chart.tunnel}</text>
        <text class="t t--peak" x={sx(e0)} y={sy(0.72) - 12} text-anchor="middle">{gamow.chart.peak}</text>
        <text class="t t--axis" x={W - pad.r} y={H - 16} text-anchor="end">{gamow.chart.energy} →</text>
        <text class="t t--axis" x={pad.l} y={H - 16}>0</text>
        <text class="t t--axis" transform={`translate(16 ${sy(0.5)}) rotate(-90)`} text-anchor="middle">{gamow.chart.prob}</text>
      </svg>
    </figure>
  </div>
</section>

<style>
  .gamow__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .gamow__fact {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-strong);
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
  }
  .gamow__value {
    font-size: clamp(2.125rem, 3.6vw, 3rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    color: var(--copper-light);
    white-space: nowrap;
  }
  .gamow__label {
    flex: 1 1 14em;
    font-size: 0.9375rem;
    color: var(--text-faint);
    text-wrap: balance;
  }
  .gamow__chart {
    margin: 0;
    padding: clamp(1rem, 2.4vw, 2rem);
    border: 1px solid var(--line);
    background:
      radial-gradient(120% 90% at 50% 100%, rgba(194, 124, 78, 0.08), transparent 60%),
      var(--ink-850);
  }
  svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .grid line {
    stroke: var(--line);
    stroke-dasharray: 2 6;
  }
  .axis {
    stroke: var(--line-strong);
  }
  .curve {
    fill: none;
    stroke-width: 1.6;
  }
  .curve--mb {
    stroke: #7f9cc7;
  }
  .curve--tun {
    stroke: #b9c3d3;
    stroke-dasharray: none;
  }
  .curve--peak {
    stroke: var(--copper-light);
    stroke-width: 2;
  }
  .peak-area {
    fill: url(#gamow-fill);
  }
  .e0 {
    stroke: var(--copper);
    stroke-dasharray: 3 4;
  }
  .t {
    font-family: var(--font-sans);
    font-size: 17px;
    fill: var(--text-dim);
  }
  .t--peak {
    fill: var(--copper-light);
    font-weight: 500;
  }
  .t--mb {
    fill: #9bb3d6;
  }
  .t--axis {
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.08em;
    fill: var(--text-faint);
  }

  :global(.js) .draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s cubic-bezier(0.5, 0, 0.2, 1);
  }
  :global(.js) .curve--tun.draw {
    transition-delay: 0.3s;
  }
  :global(.js) .curve--peak.draw {
    transition-delay: 1s;
  }
  :global(.js) .peak-area,
  :global(.js) .e0,
  :global(.js) .t {
    opacity: 0;
    transition: opacity 1s ease 1.6s;
  }
  :global(.js) .is-in .draw {
    stroke-dashoffset: 0;
  }
  :global(.js) .is-in .peak-area,
  :global(.js) .is-in .e0,
  :global(.js) .is-in .t {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .draw {
      stroke-dashoffset: 0;
      transition: none;
    }
    :global(.js) .peak-area,
    :global(.js) .e0,
    :global(.js) .t {
      opacity: 1;
      transition: none;
    }
  }

  @media (max-width: 960px) {
    .gamow__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .t {
      font-size: 30px;
    }
    .t--axis {
      font-size: 24px;
    }
    .t--mb {
      display: none;
    }
  }
</style>
