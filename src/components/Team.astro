---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="section team" id="team">
  <div class="wrap team__grid">
    <div>
      <p class="kicker" data-reveal>{t.team.kicker}</p>
      <h2 class="h2" data-reveal style="--d:.1s">{t.team.title}</h2>
      <p class="lead" data-reveal style="--d:.2s">{t.team.intro}</p>
      <p data-reveal style="--d:.25s"><span class="verify" style="margin-left:0">{t.team.verifyNote}</span></p>
    </div>
    <ul class="team__list">
      {
        t.team.partners.map((p, i) => (
          <li data-reveal style={`--d:${i * 0.05}s`}>
            <span class="team__idx">{String(i + 1).padStart(2, '0')}</span>
            <span>{p}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .team__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px);
  }
  .team__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line-strong);
    align-self: start;
  }
  .team__list li {
    display: flex;
    align-items: baseline;
    gap: 24px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font-size: 18px;
    font-weight: 300;
    transition: padding 0.3s, color 0.3s;
  }
  .team__list li:hover {
    padding-left: 10px;
    color: var(--copper-light);
  }
  .team__idx {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }
  @media (max-width: 860px) {
    .team__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
