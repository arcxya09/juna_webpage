---
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { img, widths } from '../lib/img';

interface Props {
  t: Content;
}

const { team } = Astro.props.t;
const photo = img('team-a1.jpg');
---

<section class="section team" id="team">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <p class="kicker" data-reveal>{team.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{team.title}</h2>
      </div>
      <p class="lead" data-reveal style="--d:.16s">{team.body}</p>
    </div>
  </div>

  <figure class="team__photo">
    <div class="team__media" data-reveal="clip">
      <Image src={photo} alt={team.caption} widths={widths(photo)} sizes="100vw" loading="lazy" />
    </div>
    <figcaption class="wrap">{team.caption}</figcaption>
  </figure>

  <div class="wrap">
    <dl class="team__groups">
      {
        team.groups.map((g, i) => (
          <div class:list={[i === team.groups.length - 1 && 'is-wide']} data-reveal style={`--d:${(i % 2) * 0.08}s`}>
            <dt>{g.k}</dt>
            <dd>{g.v}</dd>
          </div>
        ))
      }
    </dl>
    <div class="team__support" data-reveal>
      <span class="label">{team.supportTitle}</span>
      <p>{team.support}</p>
    </div>
  </div>
</section>

<style>
  .team {
    border-top: 1px solid var(--line);
  }
  .team__photo {
    margin: 0 0 clamp(3.5rem, 7vw, 6rem);
  }
  .team__media {
    aspect-ratio: 21 / 10;
    max-height: 88svh;
    width: 100%;
    overflow: hidden;
  }
  .team__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 78%;
  }
  .team__photo figcaption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .team__groups {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--line-strong);
  }
  .team__groups div {
    padding: 1.625rem 0;
    border-bottom: 1px solid var(--line);
  }
  .team__groups .is-wide {
    grid-column: 1 / -1;
  }
  .team__groups dt {
    font-size: 0.9375rem;
    color: var(--copper-light);
    margin-bottom: 0.625rem;
  }
  .team__groups dd {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.9;
    color: var(--text-dim);
  }
  .team__support {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  .team__support .label {
    padding-top: 0.25rem;
  }
  .team__support p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
  }
  @media (max-width: 760px) {
    .team__media {
      aspect-ratio: 3 / 2;
    }
    .team__groups {
      grid-template-columns: minmax(0, 1fr);
    }
    .team__support {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>
