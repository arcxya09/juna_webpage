---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section apparatus" id="apparatus">
  <div class="wrap">
    <p class="kicker" data-reveal>{t.apparatus.kicker}</p>
    <h2 class="h2" data-reveal style="--d:.1s">{t.apparatus.title}</h2>
    <p class="lead" data-reveal style="--d:.2s">{t.apparatus.intro}</p>
  </div>
  <div class="wrap apparatus__media">
    <figure class="apparatus__fig apparatus__fig--wide" data-reveal>
      <div class="apparatus__img" data-parallax="0.08" style={`background-image:url(${base}/images/beamline.jpg)`}></div>
      <figcaption>Beamline · placeholder</figcaption>
    </figure>
    <figure class="apparatus__fig" data-reveal style="--d:.1s">
      <div class="apparatus__img" data-parallax="0.12" style={`background-image:url(${base}/images/detector.jpg)`}></div>
      <figcaption>BGO array · placeholder</figcaption>
    </figure>
  </div>
  <div class="wrap">
    <div class="apparatus__list">
      {
        t.apparatus.items.map((it, i) => (
          <article data-reveal style={`--d:${i * 0.08}s`}>
            <span class="apparatus__tag">{it.tag}</span>
            <h3>
              {it.name}
              {it.verify && <span class="verify">{t.results.verifyNote}</span>}
            </h3>
            <p>{it.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .apparatus__media {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
  }
  .apparatus__fig {
    margin: 0;
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
  }
  .apparatus__fig--wide {
    aspect-ratio: auto;
  }
  .apparatus__img {
    position: absolute;
    inset: -12% 0;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
  .apparatus__fig figcaption {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .apparatus__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(48px, 6vw, 80px);
    border-top: 1px solid var(--line-strong);
  }
  .apparatus__list article {
    padding: 28px 28px 0 0;
  }
  .apparatus__list article + article {
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }
  .apparatus__tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--copper-light);
  }
  .apparatus__list h3 {
    font-size: 20px;
    font-weight: 400;
    margin: 14px 0 12px;
    line-height: 1.35;
  }
  .apparatus__list p {
    margin: 0;
    font-size: 15px;
    color: var(--text-dim);
  }
  @media (max-width: 1000px) {
    .apparatus__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .apparatus__list article,
    .apparatus__list article + article {
      padding: 28px 20px 28px 0;
      border-left: 0;
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 720px) {
    .apparatus__media {
      grid-template-columns: 1fr;
    }
    .apparatus__fig,
    .apparatus__fig--wide {
      aspect-ratio: 16 / 10;
    }
    .apparatus__list {
      grid-template-columns: 1fr;
    }
  }
</style>
