---
import type { Content, Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otherHref = lang === 'zh' ? `${base}/en/` : `${base}/`;
const links = ['science', 'underground', 'platform', 'history', 'results', 'future', 'team'] as const;
// The banner needs ~300px. Where the links leave no room for it (English
// labels on small laptops, very narrow phones) fall back to the logo mark.
const markMedia = lang === 'en' ? '(max-width: 340px), (min-width: 961px) and (max-width: 1240px)' : '(max-width: 340px)';
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="brand" href="#top">
      <picture>
        <source media={markMedia} srcset={`${base}/brand/juna-logo-dark.svg`} width="108" height="60" />
        <img
          src={`${base}/brand/juna-banner-dark.svg`}
          alt="JUNA 锦屏深地核天体物理实验 Jinping Underground Nuclear Astrophysics Experiment"
          width="480"
          height="67"
        />
      </picture>
    </a>
    <nav class="nav__links" aria-label="Sections">
      {links.map((k) => <a href={`#${k}`}>{t.nav[k]}</a>)}
    </nav>
    <div class="nav__tools">
      <a class="nav__lang" href={otherHref} hreflang={lang === 'zh' ? 'en' : 'zh-CN'} aria-label={t.nav.switchAria}>{t.nav.switchLabel}</a>
      <button class="nav__toggle" type="button" aria-label="Menu" aria-expanded="false" data-nav-toggle>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    transition: background 0.35s, border-color 0.35s, backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgba(8, 16, 28, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  .nav__inner {
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .brand {
    display: flex;
    align-items: center;
    flex: none;
  }
  .brand img {
    display: block;
    width: auto;
    height: 42px;
  }
  .nav__links {
    display: flex;
    gap: 28px;
    margin-left: auto;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .nav__links a {
    position: relative;
    padding: 6px 0;
    transition: color 0.2s;
  }
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--copper);
    transition: right 0.3s;
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--text);
  }
  .nav__links a:hover::after,
  .nav__links a.is-active::after {
    right: 0;
  }
  .nav__tools {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nav__lang {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    transition: border-color 0.2s, color 0.2s;
  }
  .nav__lang:hover {
    border-color: var(--copper);
    color: var(--copper-light);
  }
  .nav__toggle {
    display: none;
    width: 36px;
    height: 36px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    position: relative;
  }
  .nav__toggle span {
    position: absolute;
    left: 8px;
    right: 8px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s, top 0.3s;
  }
  .nav__toggle span:first-child {
    top: 13px;
  }
  .nav__toggle span:last-child {
    top: 21px;
  }
  .nav.is-open .nav__toggle span:first-child {
    top: 17px;
    transform: rotate(45deg);
  }
  .nav.is-open .nav__toggle span:last-child {
    top: 17px;
    transform: rotate(-45deg);
  }

  @media (max-width: 960px) {
    .nav__inner {
      gap: 16px;
    }
    .brand img {
      height: 32px;
    }
    .nav__links {
      position: fixed;
      inset: var(--nav-h) 0 auto 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 24px;
      background: rgba(10, 18, 32, 0.97);
      border-bottom: 1px solid var(--line);
      font-size: 15px;
      transform: translateY(-8px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s, transform 0.25s;
    }
    .nav__links a {
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
    }
    .nav__links a::after {
      display: none;
    }
    .nav.is-open .nav__links {
      opacity: 1;
      transform: none;
      pointer-events: auto;
    }
    .nav.is-open {
      background: rgba(10, 18, 32, 0.97);
    }
    .nav__tools {
      margin-left: auto;
    }
    .nav__toggle {
      display: block;
    }
  }
  @media (max-width: 380px) {
    .brand img {
      height: 28px;
    }
  }
</style>
