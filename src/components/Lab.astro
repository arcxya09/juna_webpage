---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Positions of each layer on the gauge, as a fraction of 2400 m.
const stops = [0, 0.25, 0.583, 1];
---

<section class="section lab" id="lab" data-depth>
  <div class="lab__bg" data-parallax="0.2" style={`background-image:url(${base}/images/rock-strata.jpg)`}></div>
  <div class="wrap lab__grid">
    <div class="lab__text">
      <p class="kicker" data-reveal>{t.lab.kicker}</p>
      <h2 class="h2" data-reveal style="--d:.1s">{t.lab.title}</h2>
      <p class="lead" data-reveal style="--d:.2s">{t.lab.body}</p>
    </div>
    <div class="gauge" data-reveal style="--d:.15s">
      <div class="gauge__label">{t.lab.depthLabel}</div>
      <div class="gauge__track">
        <div class="gauge__fill" data-depth-fill></div>
        <div class="gauge__readout"><span data-depth-readout>0</span> m</div>
        <div class="gauge__marker" data-depth-marker></div>
        {
          t.lab.layers.map((l, i) => (
            <div class={`gauge__stop${i === t.lab.layers.length - 1 ? ' gauge__stop--target' : ''}`} style={`top:${stops[i] * 100}%`}>
              <span class="gauge__depth">{l.depth}</span>
              <span class="gauge__name">{l.name}</span>
              {l.note && <span class="gauge__note">{l.note}</span>}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .lab {
    overflow: hidden;
    background: var(--ink-950);
  }
  .lab__bg {
    position: absolute;
    inset: -15% 0;
    background-size: cover;
    background-position: center;
    opacity: 0.9;
    will-change: transform;
  }
  .lab__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(48px, 8vw, 128px);
    align-items: center;
  }
  .gauge {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 24px;
    height: min(560px, 70vh);
    margin-top: 64px;
  }
  .gauge__label {
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .gauge__track {
    position: relative;
    border-left: 1px solid var(--line-strong);
    background-image: repeating-linear-gradient(to bottom, var(--line) 0 1px, transparent 1px 5%);
    background-size: 10px 100%;
    background-repeat: no-repeat;
  }
  .gauge__fill {
    position: absolute;
    left: -1px;
    top: 0;
    width: 2px;
    height: 0;
    background: linear-gradient(var(--copper-light), var(--copper));
  }
  .gauge__readout {
    position: absolute;
    left: 24px;
    bottom: calc(100% + 20px);
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 300;
    color: var(--copper-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .gauge__marker {
    position: absolute;
    left: -6px;
    top: 0;
    width: 11px;
    height: 11px;
    transform: translateY(-50%);
    z-index: 1;
  }
  .gauge__marker::before {
    content: '';
    position: absolute;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--copper-light);
    box-shadow: 0 0 0 5px rgba(224, 167, 122, 0.18);
  }
  .gauge__stop {
    position: absolute;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: grid;
    grid-template-columns: 96px 1fr;
    column-gap: 16px;
    padding-left: 140px;
    border-top: 1px dashed var(--line);
    padding-top: 8px;
  }
  .gauge__depth {
    position: absolute;
    left: 24px;
    top: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-faint);
  }
  .gauge__name {
    grid-column: 1 / -1;
    font-size: 15px;
  }
  .gauge__note {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--text-faint);
  }
  .gauge__stop--target {
    border-top-color: var(--copper);
  }
  .gauge__stop--target .gauge__name,
  .gauge__stop--target .gauge__depth {
    color: var(--copper-light);
  }
  @media (max-width: 860px) {
    .lab__grid {
      grid-template-columns: 1fr;
    }
    .gauge {
      height: 460px;
    }
    .gauge__stop {
      padding-left: 112px;
    }
  }
</style>
