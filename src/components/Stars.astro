---
import type { Content } from '../i18n/content';
import Reaction from './Reaction.astro';

interface Props {
  t: Content;
}

const { stars } = Astro.props.t;
---

<section class="section" id="stars">
  <div class="wrap">
    <div class="head">
      <p class="kicker" data-reveal>{stars.kicker}</p>
      <h2 class="h2" data-reveal style="--d:.08s">{stars.title}</h2>
    </div>

    <ol class="pillars">
      {
        stars.pillars.map((p, i) => (
          <li data-reveal style={`--d:${i * 0.08}s`}>
            <span class="pillars__i">{String(i + 1).padStart(2, '0')}</span>
            <h3>{p.k}</h3>
            <p>{p.v}</p>
          </li>
        ))
      }
    </ol>

    <div class="classes">
      <p class="label classes__title" data-reveal>{stars.classesTitle}</p>
      <div class="classes__grid">
        {
          stars.classes.map((c, i) => (
            <article class="cls" data-reveal style={`--d:${i * 0.1}s`}>
              <header>
                <h3>{c.k}</h3>
                <p>{c.note}</p>
              </header>
              <ul>
                {c.reactions.map((r) => (
                  <li>
                    <Reaction text={r} />
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .pillars {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .pillars li {
    padding: 1.75rem 1.75rem 0.5rem 0;
  }
  .pillars li + li {
    padding-left: 1.75rem;
    border-left: 1px solid var(--line);
  }
  .pillars__i {
    font-size: 0.7812rem;
    letter-spacing: 0.14em;
    color: var(--copper);
  }
  .pillars h3 {
    font-size: 1.5rem;
    font-weight: 400;
    margin: 1.125rem 0 0.75rem;
  }
  .pillars p {
    color: var(--text-dim);
    font-size: 0.9688rem;
    margin: 0;
  }

  .classes {
    margin-top: clamp(4.5rem, 9vw, 7.5rem);
  }
  .classes__title {
    margin: 0 0 1.25rem;
  }
  .classes__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .cls {
    position: relative;
    padding: 2rem 2rem 1.75rem;
    background: linear-gradient(160deg, var(--ink-800), var(--ink-850));
    border: 1px solid var(--line);
    overflow: hidden;
  }
  .cls::before {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 3rem;
    height: 2px;
    background: var(--copper);
  }
  .cls header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }
  .cls h3 {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
  }
  .cls header p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-faint);
    text-align: right;
  }
  .cls ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cls li {
    padding: 1.125rem 0 0;
    font-size: clamp(1.5rem, 2vw, 1.75rem);
    font-weight: 250;
    color: var(--copper-light);
  }

  @media (max-width: 960px) {
    .pillars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pillars li + li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .pillars li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
      margin-top: 1.25rem;
    }
    .classes__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .pillars {
      grid-template-columns: minmax(0, 1fr);
    }
    .pillars li,
    .pillars li + li {
      padding: 1.375rem 0 0.375rem;
      border-left: 0;
      margin-top: 0;
    }
    .pillars li + li {
      border-top: 1px solid var(--line);
    }
    .cls {
      padding: 1.625rem 1.375rem 1.375rem;
    }
  }
</style>
