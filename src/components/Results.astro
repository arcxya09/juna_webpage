---
import type { Content } from '../i18n/content';
import Fig from './Fig.astro';
import Reaction from './Reaction.astro';
import T from './T.astro';

interface Props {
  t: Content;
}

const { results: r } = Astro.props.t;
---

<section class="section results" id="findings">
  <div class="wrap">
    {
      r.stories.map((s, i) => (
        <article class="story" id={`r-${s.id}`}>
          <div class="story__meta">
            <div class="story__sticky">
              <span class="story__i" data-reveal>
                3.{i + 1}
              </span>
              <p class="story__reaction" data-reveal style="--d:.06s">
                <Reaction text={s.reaction} />
              </p>
              <h3 class="story__title" data-reveal style="--d:.12s">
                {s.title}
              </h3>
              <p class="story__venue" data-reveal style="--d:.18s">
                <a class="link" href={s.href} target="_blank" rel="noopener">
                  {s.venue} ↗
                </a>
                {s.extra && <span>{s.extra}</span>}
              </p>
              <div class="story__stat" data-reveal style="--d:.24s">
                <span class="story__value">
                  <T s={s.stat.value} />
                </span>
                <span class="story__label">
                  <T s={s.stat.label} />
                </span>
              </div>
            </div>
          </div>

          <div class="story__body">
            {s.fig && (
              <Fig
                name={s.fig.name}
                alt={s.fig.caption}
                caption={s.fig.caption}
                plate={s.fig.plate}
                sizes="(min-width: 960px) 56vw, 100vw"
                class="story__fig"
              />
            )}
            <p class="story__lead" data-reveal>
              <T s={s.lead} />
            </p>
            <ol class="story__points">
              {s.points.map((p, j) => (
                <li data-reveal style={`--d:${j * 0.08}s`}>
                  <span>{String(j + 1).padStart(2, '0')}</span>
                  <p>
                    <T s={p} />
                  </p>
                </li>
              ))}
            </ol>
            {s.quote && (
              <blockquote class="story__quote" data-reveal>
                <p>
                  <T s={s.quote.text} />
                </p>
                <cite>{s.quote.cite}</cite>
              </blockquote>
            )}
          </div>
        </article>
      ))
    }

    <div class="more">
      {
        r.more.map((m, i) => (
          <article class="more__card" data-reveal style={`--d:${i * 0.1}s`}>
            <span class="story__i">3.{r.stories.length + i + 1}</span>
            <p class="more__reaction">
              <Reaction text={m.reaction} />
            </p>
            <h3>{m.title}</h3>
            <p class="more__text">
              <T s={m.text} />
            </p>
            <p class="more__venue">{m.venue}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section section--deep summary" id="summary">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <p class="kicker" data-reveal>{r.summary.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{r.summary.title}</h2>
      </div>
      <p class="lead" data-reveal style="--d:.16s">{r.summary.note}</p>
    </div>
    <div class="table-scroll" data-reveal>
      <table class="table summary__table">
        <thead>
          <tr>{r.summary.head.map((h) => <th scope="col">{h}</th>)}</tr>
        </thead>
        <tbody>
          {
            r.summary.rows.map((row) =>
              row.metrics.map((m, j) => (
                <tr class:list={[j === row.metrics.length - 1 && 'is-last']}>
                  {j === 0 && (
                    <th scope="row" rowspan={row.metrics.length}>
                      <Reaction text={row.reaction} />
                    </th>
                  )}
                  {j === 0 && (
                    <td rowspan={row.metrics.length} class="summary__meaning">
                      <T s={row.meaning} />
                    </td>
                  )}
                  <td class="summary__metric">{m[0]}</td>
                  <td class="summary__prev">{m[1]}</td>
                  <td class="summary__juna">{m[2]}</td>
                  {j === 0 && (
                    <td rowspan={row.metrics.length} class="summary__venue">
                      {row.venue}
                    </td>
                  )}
                </tr>
              )),
            )
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 7rem);
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    border-top: 1px solid var(--line);
  }
  .story:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .story__sticky {
    position: sticky;
    top: calc(var(--nav-h) + 6rem);
  }
  .story__i {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.14em;
    color: var(--copper);
  }
  .story__reaction {
    margin: 1.125rem 0 0.875rem;
    font-size: clamp(2.25rem, 4.4vw, 3.75rem);
    line-height: 1.05;
    font-weight: 200;
    letter-spacing: -0.02em;
    color: var(--copper-light);
  }
  .story__title {
    font-size: clamp(1.375rem, 2.2vw, 1.875rem);
    line-height: 1.3;
    font-weight: 400;
    margin: 0 0 1.125rem;
  }
  .story__venue {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 0.875rem;
    font-size: 0.9375rem;
    margin: 0 0 2.25rem;
  }
  .story__venue span {
    color: var(--text-faint);
  }
  .story__stat {
    padding-top: 1.375rem;
    border-top: 1px solid var(--line-strong);
  }
  .story__value {
    display: block;
    font-size: clamp(2.5rem, 4.6vw, 4rem);
    line-height: 1;
    font-weight: 200;
    letter-spacing: -0.03em;
    white-space: nowrap;
    margin-bottom: 0.625rem;
  }
  .story__label {
    font-size: 0.9062rem;
    color: var(--text-faint);
  }

  .story__body :global(.story__fig) {
    margin-bottom: 2.5rem;
  }
  .story__lead {
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.8;
    font-weight: 300;
    color: var(--text);
    margin: 0 0 2rem;
  }
  .story__points {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .story__points li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.625rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .story__points span {
    font-family: var(--font-mono);
    font-size: 0.7812rem;
    color: var(--copper);
    padding-top: 0.3125rem;
  }
  .story__points p {
    margin: 0;
    color: var(--text-dim);
    font-size: 1rem;
  }
  .story__quote {
    position: relative;
    margin: 2.5rem 0 0;
    padding: 2.25rem 2.25rem 2rem 2.5rem;
    background: linear-gradient(140deg, var(--ink-800), var(--ink-850));
    border-left: 2px solid var(--copper);
  }
  .story__quote::before {
    content: '“';
    position: absolute;
    top: -0.875rem;
    left: 1.5rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 5.5rem;
    line-height: 1;
    color: var(--copper);
  }
  .story__quote p {
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    font-weight: 300;
    margin: 0 0 1rem;
  }
  .story__quote cite {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 3rem);
  }
  .more__card {
    padding: 2rem 2.25rem;
    border: 1px solid var(--line);
    background: var(--ink-850);
  }
  .more__reaction {
    margin: 0.875rem 0 0.375rem;
    font-size: clamp(1.625rem, 2.6vw, 2.125rem);
    font-weight: 250;
    color: var(--copper-light);
  }
  .more__card h3 {
    font-size: 1.1875rem;
    font-weight: 400;
    margin: 0 0 0.75rem;
  }
  .more__text {
    color: var(--text-dim);
    margin: 0 0 1.125rem;
  }
  .more__venue {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-faint);
    margin: 0;
  }

  .summary__table tbody th {
    text-align: left;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 300;
    letter-spacing: 0;
    text-transform: none;
    color: var(--copper-light);
    padding: 1.125rem 1.5rem 1.125rem 0;
    border-bottom: 1px solid var(--line-strong);
    vertical-align: top;
  }
  .summary__table td {
    border-bottom-color: transparent;
  }
  .summary__table tr.is-last td,
  .summary__table td[rowspan] {
    border-bottom: 1px solid var(--line-strong);
  }
  .summary__metric {
    font-size: 0.9062rem;
    color: var(--text-faint) !important;
    white-space: nowrap;
  }
  .summary__prev {
    white-space: nowrap;
    text-decoration: line-through;
    text-decoration-color: rgba(163, 173, 189, 0.4);
  }
  .summary__juna {
    white-space: nowrap;
    color: var(--text) !important;
    font-weight: 500;
  }
  .summary__venue {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-faint) !important;
    min-width: 11.25rem;
  }
  .summary__meaning {
    min-width: 7.5rem;
  }

  @media (max-width: 960px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
    .story__sticky {
      position: static;
    }
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .more__card {
      padding: 1.625rem 1.375rem;
    }
    .story__quote {
      padding: 2rem 1.375rem 1.625rem 1.625rem;
    }
  }
</style>
