---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="section mission" id="mission">
  <div class="wrap mission__grid">
    <div>
      <p class="kicker" data-reveal>{t.mission.kicker}</p>
      <h2 class="h2" data-reveal style="--d:.1s">{t.mission.title}</h2>
    </div>
    <div class="mission__body">
      {t.mission.body.map((p, i) => <p class="lead" data-reveal style={`--d:${0.1 + i * 0.08}s`}>{p}</p>)}
    </div>
  </div>
  <div class="wrap">
    <ol class="mission__qs">
      {
        t.mission.questions.map((q, i) => (
          <li data-reveal style={`--d:${i * 0.1}s`}>
            <span class="mission__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{q.k}</h3>
            <p>{q.v}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .mission__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(32px, 6vw, 96px);
  }
  .mission__body .lead {
    margin: 0 0 24px;
  }
  .mission__qs {
    list-style: none;
    margin: clamp(64px, 8vw, 112px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line-strong);
  }
  .mission__qs li {
    padding: 32px 32px 8px 0;
    border-right: 1px solid var(--line);
  }
  .mission__qs li + li {
    padding-left: 32px;
  }
  .mission__qs li:last-child {
    border-right: 0;
  }
  .mission__n {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--copper-light);
  }
  .mission__qs h3 {
    font-size: 22px;
    font-weight: 400;
    margin: 14px 0 10px;
  }
  .mission__qs p {
    margin: 0;
    color: var(--text-dim);
    font-size: 15px;
  }
  @media (max-width: 860px) {
    .mission__grid,
    .mission__qs {
      grid-template-columns: 1fr;
    }
    .mission__qs li,
    .mission__qs li + li {
      padding: 28px 0;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
