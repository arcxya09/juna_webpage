---
// Home: a slow band of the reactions JUNA has measured or is measuring.
import Reaction from './Reaction.astro';

const reactions = [
  '¹²C(α,γ)¹⁶O',
  '¹⁹F(p,γ)²⁰Ne',
  '²⁵Mg(p,γ)²⁶Al',
  '¹³C(α,n)¹⁶O',
  '¹⁹F(p,αγ)¹⁶O',
  '¹⁸O(α,γ)²²Ne',
  '¹⁴N(p,γ)¹⁵O',
  '²²Ne(α,n)²⁵Mg',
  '³He(α,γ)⁷Be',
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {
      [0, 1].map(() => (
        <div class="marquee__set">
          {reactions.map((r, i) => (
            <span class:list={['marquee__item', i % 2 && 'is-dim']}>
              <Reaction text={r} />
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: clamp(1.25rem, 3vw, 2.25rem) 0;
    background: var(--ink-950);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 60s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__set {
    display: flex;
    flex: none;
  }
  .marquee__item {
    flex: none;
    padding: 0 clamp(1.5rem, 3vw, 3rem);
    font-size: clamp(2.25rem, 4.2vw, 3.75rem);
    line-height: 1.2;
    font-weight: 200;
    letter-spacing: -0.02em;
    color: var(--copper-light);
  }
  .marquee__item.is-dim {
    color: rgba(236, 238, 242, 0.28);
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
