---
// Closing panel of a chapter page: a large link into the next chapter.
import { Image } from 'astro:assets';
import type { Content, Lang } from '../i18n/content';
import { img, widths } from '../lib/img';
import { COVERS, href, nextChapter, type Chapter } from '../lib/routes';
import T from './T.astro';

interface Props {
  t: Content;
  lang: Lang;
  page: Chapter;
}

const { t, lang, page } = Astro.props;
const next = nextChapter(page);
const ch = t.chapters[next];
const cover = COVERS[next];
const photo = img(cover.image);
---

<a class="next" href={href(lang, next)} data-reveal="fade">
  <div class="next__media">
    <Image src={photo} alt="" widths={widths(photo)} sizes="100vw" loading="lazy" style={`object-position:${cover.pos}`} />
  </div>
  <div class="next__shade" aria-hidden="true"></div>
  <div class="wrap next__inner">
    <span class="kicker">{t.pageNav.next}</span>
    <span class="next__row">
      <span class="next__num" aria-hidden="true">{ch.num}</span>
      <span class="next__text">
        <span class="next__title"><T s={ch.title} /></span>
        <span class="next__teaser">{t.home.teasers[next]}</span>
      </span>
      <span class="next__arrow" aria-hidden="true">
        <svg viewBox="0 0 48 48"><path d="M8 24h30M28 13l11 11-11 11"></path></svg>
      </span>
    </span>
  </div>
</a>

<style>
  .next {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(23.75rem, 62vh, 38.75rem);
    overflow: hidden;
    isolation: isolate;
    background: var(--ink-950);
    border-top: 1px solid var(--line);
  }
  .next__media {
    position: absolute;
    inset: 0;
  }
  .next__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.6) brightness(0.8);
    transform: scale(1.04);
    transition:
      transform 1.4s var(--ease),
      filter 0.8s;
  }
  .next__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgba(4, 8, 14, 0.95) 0%, rgba(4, 8, 14, 0.55) 55%, rgba(4, 8, 14, 0.35) 100%),
      linear-gradient(90deg, rgba(4, 8, 14, 0.6), transparent 70%);
    transition: opacity 0.8s;
  }
  .next__inner {
    position: relative;
    z-index: 1;
    padding-top: 5rem;
    padding-bottom: clamp(3rem, 8vh, 5.5rem);
  }
  .next__row {
    display: flex;
    align-items: flex-end;
    gap: clamp(1.25rem, 3vw, 3rem);
  }
  .next__num {
    font-size: clamp(5.5rem, 13vw, 12.5rem);
    line-height: 0.78;
    font-weight: 100;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(227, 171, 128, 0.7);
    transition: -webkit-text-stroke-color 0.5s;
  }
  .next__text {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
  }
  .next__title {
    font-size: clamp(2rem, 4.6vw, 4rem);
    line-height: 1.08;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  :global(html[lang='zh-CN']) .next__title {
    letter-spacing: 0.03em;
    line-height: 1.25;
  }
  .next__teaser {
    color: var(--text-dim);
    font-size: 1rem;
  }
  .next__arrow {
    margin-left: auto;
    flex: none;
    width: clamp(4rem, 7vw, 6rem);
    height: clamp(4rem, 7vw, 6rem);
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background 0.4s,
      border-color 0.4s,
      transform 0.6s var(--ease);
  }
  .next__arrow svg {
    width: 44%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    transition: transform 0.6s var(--ease);
  }
  .next:hover .next__media img {
    transform: scale(1.1);
    filter: saturate(0.9) brightness(0.95);
  }
  .next:hover .next__num {
    -webkit-text-stroke-color: var(--copper-light);
  }
  .next:hover .next__arrow {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--ink-950);
  }
  .next:hover .next__arrow svg {
    transform: translateX(0.375rem);
  }
  @media (max-width: 720px) {
    .next__row {
      flex-wrap: wrap;
    }
    .next__num {
      flex-basis: 100%;
    }
    .next__arrow {
      width: 3.5rem;
      height: 3.5rem;
    }
  }
</style>
