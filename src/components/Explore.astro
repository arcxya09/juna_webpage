---
// Home: one large card per chapter.
import { Image } from 'astro:assets';
import type { Content, Lang } from '../i18n/content';
import { img, widths } from '../lib/img';
import { CHAPTERS, COVERS, href } from '../lib/routes';
import T from './T.astro';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
// Zig-zag spans on a 12-column grid.
const span = { science: 7, facility: 5, results: 5, future: 7, about: 12 } as const;
---

<section class="section explore">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <p class="kicker" data-reveal>{t.home.explore.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{t.home.explore.title}</h2>
      </div>
    </div>
    <div class="explore__grid">
      {
        CHAPTERS.map((k, i) => {
          const cover = COVERS[k];
          const photo = img(cover.image);
          return (
            <a
              class:list={['card', `card--${span[k]}`]}
              href={href(lang, k)}
              data-glow
              data-reveal
              style={`--d:${(i % 2) * 0.1}s`}
            >
              <div class="card__media">
                <Image
                  src={photo}
                  alt=""
                  widths={widths(photo, [480, 800, 1200, 1600])}
                  sizes={span[k] === 12 ? '(min-width: 1441px) 72vw, (min-width: 1320px) 1240px, 100vw' : '(min-width: 960px) 60vw, 100vw'}
                  loading="lazy"
                  style={`object-position:${cover.pos}`}
                />
              </div>
              <div class="card__shade" aria-hidden="true" />
              <span class="card__num" aria-hidden="true">
                {t.chapters[k].num}
              </span>
              <div class="card__body">
                <span class="card__label">{t.nav[k]}</span>
                <h3 class="card__title">
                  <T s={t.chapters[k].title} />
                </h3>
                <p class="card__teaser">{t.home.teasers[k]}</p>
              </div>
              <span class="card__arrow" aria-hidden="true">
                <svg viewBox="0 0 48 48">
                  <path d="M8 24h30M28 13l11 11-11 11" />
                </svg>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .explore {
    padding-top: 0;
  }
  .explore__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
    --mx: 50%;
    --my: 50%;
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(22.5rem, 40vw, 35rem);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--line);
    background: var(--ink-950);
    transition: border-color 0.4s;
  }
  .card--7 {
    grid-column: span 7;
  }
  .card--5 {
    grid-column: span 5;
  }
  .card--12 {
    grid-column: span 12;
    min-height: clamp(18.75rem, 30vw, 26.25rem);
  }
  .card__media {
    position: absolute;
    inset: 0;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.55) brightness(0.75);
    transform: scale(1.02);
    transition:
      transform 1.4s var(--ease),
      filter 0.8s;
  }
  .card__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(26.25rem circle at var(--mx) var(--my), rgba(227, 171, 128, 0.22), transparent 60%),
      linear-gradient(0deg, rgba(4, 8, 14, 0.94) 0%, rgba(4, 8, 14, 0.45) 55%, rgba(4, 8, 14, 0.15) 100%);
    transition: opacity 0.6s;
  }
  .card__num {
    position: absolute;
    top: 1.25rem;
    left: 1.75rem;
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    color: var(--copper-light);
  }
  .card__body {
    position: relative;
    z-index: 1;
    padding: 2rem 7.5rem 2rem 1.75rem;
  }
  .card__label {
    display: block;
    font-size: 0.7812rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--copper-light);
    margin-bottom: 0.75rem;
  }
  .card__title {
    margin: 0 0 0.625rem;
    font-size: clamp(1.625rem, 2.2vw, 2rem);
    line-height: 1.15;
    font-weight: 300;
    letter-spacing: -0.015em;
  }
  :global(html[lang='zh-CN']) .card__title {
    letter-spacing: 0.03em;
    line-height: 1.3;
  }
  .card__teaser {
    margin: 0;
    color: var(--text-dim);
    font-size: 0.9688rem;
    max-width: 30em;
    transform: translateY(0.375rem);
    opacity: 0.85;
    transition:
      transform 0.6s var(--ease),
      opacity 0.6s;
  }
  .card__arrow {
    position: absolute;
    right: 1.75rem;
    bottom: 2rem;
    z-index: 1;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition:
      background 0.4s,
      border-color 0.4s,
      color 0.4s;
  }
  .card__arrow svg {
    width: 1.375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    transition: transform 0.6s var(--ease);
  }
  .card:hover {
    border-color: rgba(194, 124, 78, 0.55);
  }
  .card:hover .card__media img {
    transform: scale(1.09);
    filter: saturate(0.85) brightness(0.9);
  }
  .card:hover .card__teaser {
    transform: none;
    opacity: 1;
  }
  .card:hover .card__arrow {
    background: var(--copper);
    border-color: var(--copper);
    color: var(--ink-950);
  }
  .card:hover .card__arrow svg {
    transform: translateX(0.25rem);
  }
  @media (max-width: 860px) {
    .card--7,
    .card--5,
    .card--12 {
      grid-column: span 12;
      min-height: 21.25rem;
    }
    .card__body {
      padding: 1.5rem 5.5rem 1.5rem 1.375rem;
    }
    .card__num {
      left: 1.375rem;
    }
    .card__arrow {
      right: 1.375rem;
      bottom: 1.5rem;
      width: 3rem;
      height: 3rem;
    }
  }
</style>
