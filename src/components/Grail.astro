---
import { grailJuna, grailOthers, grailRecords, SHOW_PRELIMINARY, type Content } from '../i18n/content';
import T from './T.astro';

interface Props {
  t: Content;
}

const { grail } = Astro.props.t;

// Lowest energy reached by direct measurements, by year. Styled after the
// collaboration's report figure: records joined by a dashed trail, other
// measurements as open circles, the Gamow window as a solid band.
const W = 1000;
const H = 520;
const pad = { l: 92, r: 36, t: 24, b: 56 };
const x0 = 1950;
const x1 = 2030;
const yMax = 2800;
const sx = (y: number) => pad.l + ((y - x0) / (x1 - x0)) * (W - pad.l - pad.r);
const sy = (e: number) => H - pad.b - (e / yMax) * (H - pad.t - pad.b);
const xTicks = [1950, 1970, 1990, 2010, 2030];
const yTicks = [1000, 2000];
const band = { lo: 220, hi: 380 };
const trail = grailRecords.map((r, i) => `${i ? 'L' : 'M'}${sx(r.year)} ${sy(r.e)}`).join(' ');
const last = grailRecords[grailRecords.length - 1];
// Hand-placed labels, as in the report figure: [dx, dy, anchor].
const place: Record<string, [number, number, 'start' | 'end']> = {
  Bloom: [16, 6, 'start'],
  Larson: [16, 6, 'start'],
  Jaszczak: [6, -22, 'start'],
  Kettner: [62, 44, 'start'],
  Redder: [-16, 6, 'end'],
  Hammer: [-6, 42, 'end'],
  'JUNA 2021': [-16, 30, 'end'],
  'JUNA 2026': [16, -4, 'start'],
};
const labelled = SHOW_PRELIMINARY ? [...grailRecords, ...grailJuna] : grailRecords;
const juna = `M${sx(last.year)} ${sy(last.e)} ${grailJuna.map((r) => `L${sx(r.year)} ${sy(r.e)}`).join(' ')}`;
// Without published numbers JUNA is drawn as a direction, not a data point.
const arrowX = sx(2024);
const arrowTo = sy(band.hi) - 8;
const delay = (y: number) => `--t:${0.2 + ((y - 1955) / 70) * 1.6}s`;
---

<section class="section section--deep grail" id="grail">
  <div class="wrap">
    <div class="grail__top">
      <div>
        <p class="kicker kicker--formula" data-reveal><span><T s={grail.kicker} /></span></p>
        <h2 class="h2" data-reveal style="--d:.08s">{grail.title}</h2>
        {
          grail.body.map((p, i) => (
            <p class="prose" data-reveal style={`--d:${0.14 + i * 0.06}s`}>
              <T s={p} />
            </p>
          ))
        }
      </div>
      <dl class="grail__facts">
        {
          grail.facts.map((f, i) => (
            <div data-reveal style={`--d:${i * 0.1}s`}>
              <dd>
                <T s={f.value} />
              </dd>
              <dt>{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="grail__chart" data-reveal="fade">
      <figcaption class="grail__title">
        <span class="label">FIG. 4.2</span>
        <span>{grail.chartTitle}</span>
      </figcaption>
      <div class="grail__scroll">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={grail.chartTitle}>
          <defs>
            <mask id="grail-trail" maskUnits="userSpaceOnUse">
              <path class="trail-mask" d={trail} pathLength="1" />
            </mask>
          </defs>
          <g class="grid">
            {yTicks.map((e) => <line x1={pad.l} x2={W - pad.r} y1={sy(e)} y2={sy(e)} />)}
          </g>
          <rect class="band" x={pad.l} width={W - pad.l - pad.r} y={sy(band.hi)} height={sy(band.lo) - sy(band.hi)}></rect>
          <text class="band-label" x={pad.l + 18} y={sy(band.hi) - 14}>
            {grail.chartBand[0]}
            <tspan dx="16">{grail.chartBand[1]}</tspan>
          </text>

          <path class="axis" d={`M${pad.l} ${pad.t} V${sy(0)} H${W - pad.r}`}></path>
          {
            [0, ...yTicks].map((e) => (
              <text class="tick" x={pad.l - 14} y={sy(e) + 5} text-anchor="end">
                {e}
              </text>
            ))
          }
          {
            xTicks.map((y) => (
              <text class="tick" x={sx(y)} y={H - pad.b + 30} text-anchor="middle">
                {y}
              </text>
            ))
          }
          <text class="axis-title" transform={`translate(26 ${(pad.t + sy(0)) / 2}) rotate(-90)`} text-anchor="middle">
            {grail.chartAxis}
          </text>

          {grailOthers.map((p) => <circle class="pt pt--other" cx={sx(p.year)} cy={sy(p.e)} r="6.5" style={delay(p.year)} />)}
          <path class="trail" d={trail} mask="url(#grail-trail)"></path>
          {
            SHOW_PRELIMINARY ? (
              <path class="juna-line" d={juna} style={delay(2021)} />
            ) : (
              <g class="juna-dir" style={delay(2024)}>
                <path class="juna-dir__flat" d={`M${sx(last.year)} ${sy(last.e)} H${arrowX}`} />
                <path class="juna-dir__line" d={`M${arrowX} ${sy(last.e)} V${arrowTo}`} />
                <path class="juna-dir__head" d={`M${arrowX - 7} ${arrowTo - 10} L${arrowX} ${arrowTo} L${arrowX + 7} ${arrowTo - 10}`} />
                <text class="juna-dir__name" x={arrowX - 16} y={sy(last.e) + 34} text-anchor="end">
                  JUNA
                </text>
                <text class="juna-dir__note" x={arrowX - 16} y={sy(last.e) + 56} text-anchor="end">
                  {grail.chartJuna}
                </text>
              </g>
            )
          }
          {
            labelled.map((p) => {
              const isJuna = p.who.startsWith('JUNA');
              const [dx, dy, anchor] = place[p.who];
              const open = p.who === 'JUNA 2026';
              return (
                <g class:list={['rec', isJuna && 'rec--juna']} style={delay(p.year)}>
                  <circle class:list={['pt', 'pt--rec', open && 'pt--open']} cx={sx(p.year)} cy={sy(p.e)} r="7.5" />
                  <text class="rec-label" x={sx(p.year) + dx} y={sy(p.e) + dy} text-anchor={anchor}>
                    {isJuna ? p.who : `${p.who} ${p.year}`}
                    <tspan class="rec-e" dx="14">{`${p.who === 'Bloom' ? grail.chartApprox : ''}${Math.round(p.e)} keV`}</tspan>
                  </text>
                </g>
              );
            })
          }
        </svg>
      </div>
      <p class="grail__note"><T s={grail.chartNote} /></p>
    </figure>

    <div class="grail__juna" data-reveal>
      <span class="label">JUNA</span>
      <p><T s={SHOW_PRELIMINARY ? `${grail.junaPrelim} ${grail.juna}` : grail.juna} /></p>
    </div>

    <div class="gw" data-reveal>
      <div class="gw__art" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          {[18, 34, 52, 72, 94].map((r, i) => <circle cx="100" cy="100" r={r} style={`--i:${i}`} />)}
          <circle class="gw__core" cx="92" cy="100" r="5"></circle>
          <circle class="gw__core" cx="108" cy="100" r="4"></circle>
        </svg>
      </div>
      <div>
        <h3 class="h3">{grail.gw.title}</h3>
        <p class="prose"><T s={grail.gw.body} /></p>
      </div>
    </div>
  </div>
</section>

<style>
  .grail__top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .grail__facts {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .grail__facts div {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .grail__facts dd {
    margin: 0 0 4px;
    font-size: clamp(34px, 3.4vw, 46px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--copper-light);
  }
  .grail__facts dt {
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .grail__chart {
    margin: 0;
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--ink-900);
  }
  .grail__title {
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-size: 17px;
    margin-bottom: 20px;
  }
  .grail__title .label {
    flex: none;
    color: var(--copper);
  }
  .grail__scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grail__scroll svg {
    min-width: 700px;
  }
  .grid line {
    stroke: var(--line);
  }
  .axis {
    fill: none;
    stroke: rgba(236, 238, 242, 0.6);
    stroke-width: 1.5;
  }
  .band {
    fill: rgba(194, 124, 78, 0.3);
  }
  .band-label {
    font-size: 17px;
    fill: var(--copper-light);
  }
  .tick {
    font-family: var(--font-mono);
    font-size: 14px;
    fill: var(--text-faint);
  }
  .axis-title {
    font-size: 15px;
    fill: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .pt--other {
    fill: none;
    stroke: #8794a9;
    stroke-width: 1.6;
  }
  .pt--rec {
    fill: #d7dce5;
  }
  .rec-label {
    font-size: 18px;
    fill: var(--text);
  }
  .rec-e {
    fill: var(--text-dim);
  }
  .trail {
    fill: none;
    stroke: rgba(215, 220, 229, 0.6);
    stroke-width: 1.6;
    stroke-dasharray: 5 6;
  }
  .trail-mask {
    fill: none;
    stroke: #fff;
    stroke-width: 12;
  }
  .rec--juna .pt--rec {
    fill: var(--copper-light);
  }
  .rec--juna .pt--open {
    fill: var(--ink-900);
    stroke: var(--copper-light);
    stroke-width: 3;
  }
  .rec--juna .rec-label,
  .rec--juna .rec-e {
    fill: var(--copper-light);
    font-weight: 600;
  }
  .juna-line {
    fill: none;
    stroke: var(--copper-light);
    stroke-width: 2.5;
  }
  .juna-dir__flat {
    fill: none;
    stroke: rgba(215, 220, 229, 0.35);
    stroke-width: 1.6;
    stroke-dasharray: 5 6;
  }
  .juna-dir__line,
  .juna-dir__head {
    fill: none;
    stroke: var(--copper-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .juna-dir__name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.06em;
    fill: var(--copper-light);
  }
  .juna-dir__note {
    font-size: 15px;
    fill: var(--copper-light);
    opacity: 0.8;
  }
  .grail__note {
    margin: 16px 0 0;
    font-size: 13.5px;
    color: var(--text-faint);
    max-width: 52em;
  }

  :global(.js) .grail__chart .pt,
  :global(.js) .grail__chart .rec,
  :global(.js) .grail__chart .juna-line,
  :global(.js) .grail__chart .juna-dir {
    opacity: 0;
    transition: opacity 0.6s ease;
    transition-delay: var(--t, 1.8s);
  }
  :global(.js) .grail__chart .trail-mask {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s linear 0.2s;
  }
  :global(.js) .grail__chart.is-in .pt,
  :global(.js) .grail__chart.is-in .rec,
  :global(.js) .grail__chart.is-in .juna-line,
  :global(.js) .grail__chart.is-in .juna-dir {
    opacity: 1;
  }
  :global(.js) .grail__chart.is-in .trail-mask {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .grail__chart .pt,
    :global(.js) .grail__chart .rec,
    :global(.js) .grail__chart .juna-line,
    :global(.js) .grail__chart .juna-dir {
      opacity: 1;
      transition: none;
    }
    :global(.js) .grail__chart .trail-mask {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  .grail__juna {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    margin-top: 24px;
    padding: 28px 32px;
    border: 1px solid rgba(194, 124, 78, 0.45);
    background: linear-gradient(90deg, var(--copper-glow), transparent 70%);
  }
  .grail__juna .label {
    color: var(--copper-light);
    padding-top: 4px;
  }
  .grail__juna p {
    margin: 0;
    font-size: 17px;
    font-weight: 300;
  }

  .gw {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    margin-top: clamp(72px, 9vw, 128px);
  }
  .gw__art {
    max-width: 320px;
  }
  .gw__art circle {
    fill: none;
    stroke: var(--copper);
    stroke-width: 0.6;
    opacity: calc(1 - var(--i, 0) * 0.17);
    transform-origin: 100px 100px;
    animation: ripple 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.6s);
  }
  .gw__art .gw__core {
    fill: var(--copper-light);
    stroke: none;
    opacity: 1;
    animation: none;
  }
  @keyframes ripple {
    0%,
    100% {
      transform: scale(0.96);
    }
    50% {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gw__art circle {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .grail__top,
    .gw {
      grid-template-columns: minmax(0, 1fr);
    }
    .gw__art {
      max-width: 200px;
    }
  }
  @media (max-width: 600px) {
    .grail__juna {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 22px 20px;
    }
  }
</style>
