---
import { grailJuna, grailOthers, grailRecords, SHOW_PRELIMINARY, type Content } from '../i18n/content';
import T from './T.astro';

interface Props {
  t: Content;
}

const { grail } = Astro.props.t;

// Lowest energy reached by direct measurements, by year.
const W = 1000;
const H = 460;
const pad = { l: 70, r: 28, t: 28, b: 52 };
const x0 = 1950;
const x1 = 2030;
const yMax = 2800;
const sx = (y: number) => pad.l + ((y - x0) / (x1 - x0)) * (W - pad.l - pad.r);
const sy = (e: number) => H - pad.b - (e / yMax) * (H - pad.t - pad.b);
const records = SHOW_PRELIMINARY ? [...grailRecords, ...grailJuna] : grailRecords;
const step = records
  .map((r, i) => (i === 0 ? `M${sx(r.year)} ${sy(r.e)}` : `H${sx(r.year)} V${sy(r.e)}`))
  .join(' ');
const last = records[records.length - 1];
const plateau = `M${sx(last.year)} ${sy(last.e)} H${sx(2026)}`;
const xTicks = [1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020, 2030];
const yTicks = [0, 500, 1000, 1500, 2000, 2500];
const band = { lo: 220, hi: 380 };
// Put a record's label below its point when another measurement sits where
// the label would go.
const labelBelow = (p: { year: number; e: number; who: string }) => {
  const left = sx(p.year) + 10;
  const right = left + (p.who.length + 5) * 7.5;
  const top = sy(p.e) - 26;
  const bottom = sy(p.e) - 4;
  return [...grailOthers, ...records].some(
    (q) => q !== p && sx(q.year) > left - 6 && sx(q.year) < right + 6 && sy(q.e) > top - 6 && sy(q.e) < bottom + 6,
  );
};
const delay = (y: number) => `--t:${((y - 1955) / 70) * 1.6}s`;
---

<section class="section section--deep grail">
  <div class="wrap">
    <div class="grail__top">
      <div>
        <p class="kicker kicker--formula" data-reveal><span><T s={grail.kicker} /></span></p>
        <h2 class="h2" data-reveal style="--d:.08s">{grail.title}</h2>
        {
          grail.body.map((p, i) => (
            <p class="prose" data-reveal style={`--d:${0.14 + i * 0.06}s`}>
              <T s={p} />
            </p>
          ))
        }
      </div>
      <dl class="grail__facts">
        {
          grail.facts.map((f, i) => (
            <div data-reveal style={`--d:${i * 0.1}s`}>
              <dd>
                <T s={f.value} />
              </dd>
              <dt>{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="grail__chart" data-reveal="fade">
      <figcaption class="grail__title">
        <span class="label">FIG. 4.2</span>
        <span>{grail.chartTitle}</span>
      </figcaption>
      <div class="grail__scroll">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={grail.chartTitle}>
          <g class="grid">
            {yTicks.map((e) => <line x1={pad.l} x2={W - pad.r} y1={sy(e)} y2={sy(e)} />)}
          </g>
          <rect class="band" x={pad.l} width={W - pad.l - pad.r} y={sy(band.hi)} height={sy(band.lo) - sy(band.hi)}></rect>
          <text class="band-label" x={pad.l + 12} y={sy(band.hi) - 10}>
            {grail.facts[0].label} {grail.facts[0].value}
          </text>
          {
            yTicks.map((e) => (
              <text class="tick" x={pad.l - 12} y={sy(e) + 4} text-anchor="end">
                {e}
              </text>
            ))
          }
          <text class="tick" x={pad.l - 12} y={pad.t - 12} text-anchor="end">keV</text>
          {
            xTicks.map((y) => (
              <text class="tick" x={sx(y)} y={H - pad.b + 24} text-anchor="middle">
                {y}
              </text>
            ))
          }
          <line class="axis" x1={pad.l} x2={W - pad.r} y1={sy(0)} y2={sy(0)}></line>

          {grailOthers.map((p) => <circle class="pt pt--other" cx={sx(p.year)} cy={sy(p.e)} r="4.5" style={delay(p.year)} />)}
          <path class="step" d={step} pathLength="1"></path>
          <path class="plateau" d={plateau}></path>
          {
            records.map((p) => (
              <g class:list={['rec', p.who.startsWith('JUNA') && 'rec--juna']} style={delay(p.year)}>
                <circle class="pt pt--rec" cx={sx(p.year)} cy={sy(p.e)} r="6" />
                <text class="rec-label" x={sx(p.year) + 10} y={labelBelow(p) ? sy(p.e) + 22 : sy(p.e) - 10}>
                  {p.who} {Math.floor(p.year)}
                </text>
              </g>
            ))
          }
          {
            !SHOW_PRELIMINARY && (
              <g class="now">
                <line x1={sx(2026)} x2={sx(2026)} y1={sy(last.e) + 12} y2={sy(band.hi) - 8} />
                <path d={`M${sx(2026) - 5} ${sy(band.hi) - 14} L${sx(2026)} ${sy(band.hi) - 6} L${sx(2026) + 5} ${sy(band.hi) - 14}`} />
                <text x={sx(2026) - 10} y={(sy(last.e) + sy(band.hi)) / 2 + 4} text-anchor="end">
                  JUNA
                </text>
              </g>
            )
          }
        </svg>
      </div>
      <p class="grail__note"><T s={grail.chartNote} /></p>
    </figure>

    <div class="grail__juna" data-reveal>
      <span class="label">JUNA</span>
      <p><T s={SHOW_PRELIMINARY ? `${grail.junaPrelim} ${grail.juna}` : grail.juna} /></p>
    </div>

    <div class="gw" data-reveal>
      <div class="gw__art" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          {[18, 34, 52, 72, 94].map((r, i) => <circle cx="100" cy="100" r={r} style={`--i:${i}`} />)}
          <circle class="gw__core" cx="92" cy="100" r="5"></circle>
          <circle class="gw__core" cx="108" cy="100" r="4"></circle>
        </svg>
      </div>
      <div>
        <h3 class="h3">{grail.gw.title}</h3>
        <p class="prose"><T s={grail.gw.body} /></p>
        <p class="src">{grail.gw.source}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .grail__top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(56px, 7vw, 96px);
  }
  .grail__facts {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .grail__facts div {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .grail__facts dd {
    margin: 0 0 4px;
    font-size: clamp(34px, 3.4vw, 46px);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--copper-light);
  }
  .grail__facts dt {
    font-size: 13.5px;
    color: var(--text-faint);
  }

  .grail__chart {
    margin: 0;
    padding: clamp(20px, 3vw, 40px);
    border: 1px solid var(--line);
    background: var(--ink-900);
  }
  .grail__title {
    display: flex;
    gap: 16px;
    align-items: baseline;
    font-size: 17px;
    margin-bottom: 20px;
  }
  .grail__title .label {
    color: var(--copper);
  }
  .grail__scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grail__scroll svg {
    min-width: 680px;
  }
  .grid line {
    stroke: var(--line);
  }
  .axis {
    stroke: var(--line-strong);
  }
  .band {
    fill: rgba(194, 124, 78, 0.16);
  }
  .band-label {
    font-size: 13px;
    fill: var(--copper-light);
  }
  .tick {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--text-faint);
  }
  .pt--other {
    fill: none;
    stroke: #7f8da3;
    stroke-width: 1.2;
  }
  .pt--rec {
    fill: var(--text);
  }
  .rec-label {
    font-size: 13px;
    fill: var(--text-dim);
  }
  .rec--juna .pt--rec {
    fill: var(--copper);
  }
  .rec--juna .rec-label {
    fill: var(--copper-light);
  }
  .step {
    fill: none;
    stroke: var(--text-dim);
    stroke-width: 1.2;
  }
  .plateau {
    fill: none;
    stroke: var(--text-faint);
    stroke-dasharray: 4 5;
  }
  .now line {
    stroke: var(--copper);
    stroke-dasharray: 2 4;
  }
  .now path {
    fill: none;
    stroke: var(--copper);
  }
  .now text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--copper-light);
    letter-spacing: 0.1em;
  }
  .grail__note {
    margin: 16px 0 0;
    font-size: 13.5px;
    color: var(--text-faint);
    max-width: 52em;
  }

  :global(.js) .grail__chart .pt,
  :global(.js) .grail__chart .rec,
  :global(.js) .grail__chart .plateau,
  :global(.js) .grail__chart .now {
    opacity: 0;
    transition: opacity 0.6s ease;
    transition-delay: var(--t, 1.8s);
  }
  :global(.js) .grail__chart .step {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.8s linear;
  }
  :global(.js) .grail__chart.is-in .pt,
  :global(.js) .grail__chart.is-in .rec,
  :global(.js) .grail__chart.is-in .plateau,
  :global(.js) .grail__chart.is-in .now {
    opacity: 1;
  }
  :global(.js) .grail__chart.is-in .step {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .grail__chart .pt,
    :global(.js) .grail__chart .rec,
    :global(.js) .grail__chart .plateau,
    :global(.js) .grail__chart .now {
      opacity: 1;
      transition: none;
    }
    :global(.js) .grail__chart .step {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  .grail__juna {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    margin-top: 24px;
    padding: 28px 32px;
    border: 1px solid rgba(194, 124, 78, 0.45);
    background: linear-gradient(90deg, var(--copper-glow), transparent 70%);
  }
  .grail__juna .label {
    color: var(--copper-light);
    padding-top: 4px;
  }
  .grail__juna p {
    margin: 0;
    font-size: 17px;
    font-weight: 300;
  }

  .gw {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
    margin-top: clamp(72px, 9vw, 128px);
  }
  .gw__art {
    max-width: 320px;
  }
  .gw__art circle {
    fill: none;
    stroke: var(--copper);
    stroke-width: 0.6;
    opacity: calc(1 - var(--i, 0) * 0.17);
    transform-origin: 100px 100px;
    animation: ripple 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.6s);
  }
  .gw__art .gw__core {
    fill: var(--copper-light);
    stroke: none;
    opacity: 1;
    animation: none;
  }
  @keyframes ripple {
    0%,
    100% {
      transform: scale(0.96);
    }
    50% {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gw__art circle {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .grail__top,
    .gw {
      grid-template-columns: minmax(0, 1fr);
    }
    .gw__art {
      max-width: 200px;
    }
  }
  @media (max-width: 600px) {
    .grail__juna {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 22px 20px;
    }
  }
</style>
