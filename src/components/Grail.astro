---
import { grailJuna, grailOthers, grailRecords, SHOW_GRAIL_JUNA, SHOW_PRELIMINARY, type Content } from '../i18n/content';
import T from './T.astro';

interface Props {
  t: Content;
}

const { grail } = Astro.props.t;
const showJuna = SHOW_PRELIMINARY || SHOW_GRAIL_JUNA;

// Lowest energy reached by direct measurements, by year. Styled after the
// collaboration's report figure: records joined by a dashed trail, other
// measurements as open circles, the Gamow window as a solid band. A second,
// taller drawing replaces it on phones, with the records listed beneath.
const x0 = 1950;
const x1 = 2030;
const yMax = 2800;
const band = { lo: 220, hi: 380 };
const frame = (W: number, H: number, pad: { l: number; r: number; t: number; b: number }) => ({
  W,
  H,
  pad,
  sx: (y: number) => pad.l + ((y - x0) / (x1 - x0)) * (W - pad.l - pad.r),
  sy: (e: number) => H - pad.b - (e / yMax) * (H - pad.t - pad.b),
});
const d = frame(1000, 520, { l: 92, r: 36, t: 24, b: 56 });
const m = frame(320, 400, { l: 42, r: 12, t: 24, b: 38 });
const trailPath = (f: typeof d) => grailRecords.map((r, i) => `${i ? 'L' : 'M'}${f.sx(r.year)} ${f.sy(r.e)}`).join(' ');
const last = grailRecords[grailRecords.length - 1];
const junaPath = (f: typeof d) =>
  `M${f.sx(last.year)} ${f.sy(last.e)} ${grailJuna.map((r) => `L${f.sx(r.year)} ${f.sy(r.e)}`).join(' ')}`;
const isPrelim = (who: string) => who === 'JUNA 2026';
const energy = (p: { who: string; e: number }) => `${p.who === 'Bloom' ? grail.chartApprox : ''}${p.e} keV`;

// Hand-placed labels, as in the report figure: [dx, dy, anchor].
const place: Record<string, [number, number, 'start' | 'end' | 'middle']> = {
  Bloom: [16, 6, 'start'],
  Larson: [16, 6, 'start'],
  Jaszczak: [6, -22, 'start'],
  Kettner: [62, 44, 'start'],
  Redder: [-16, 6, 'end'],
  Hammer: [-6, 42, 'end'],
};
// Phones label records by year only; the list below the chart names them.
const placeM: Record<string, [number, number, 'start' | 'end' | 'middle']> = {
  Bloom: [9, 4, 'start'],
  Larson: [9, 4, 'start'],
  Jaszczak: [-9, 4, 'end'],
  Kettner: [0, 18, 'middle'],
  Redder: [-9, 4, 'end'],
  Hammer: [-6, 16, 'end'],
};
// Without JUNA's numbers it is drawn as a direction, not a data point.
const arrowX = d.sx(2024);
const arrowTo = d.sy(band.hi) - 8;
const delay = (y: number) => `--t:${0.2 + ((y - 1955) / 70) * 1.6}s`;
const records = showJuna ? [...grailRecords, ...grailJuna] : grailRecords;
---

<section class="section section--deep grail" id="grail">
  <div class="wrap">
    <div class="grail__top">
      <div>
        <p class="kicker kicker--formula" data-reveal><span><T s={grail.kicker} /></span></p>
        <h2 class="h2" data-reveal style="--d:.08s">{grail.title}</h2>
        {
          grail.body.map((p, i) => (
            <p class="prose" data-reveal style={`--d:${0.14 + i * 0.06}s`}>
              <T s={p} />
            </p>
          ))
        }
      </div>
      <dl class="grail__facts">
        {
          grail.facts.map((f, i) => (
            <div data-reveal style={`--d:${i * 0.1}s`}>
              <dd>
                <T s={f.value} />
              </dd>
              <dt>{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>

    <figure class="grail__chart" data-reveal="fade">
      <figcaption class="grail__title">
        <span class="label">FIG. 4.2</span>
        <span>{grail.chartTitle}</span>
      </figcaption>
      <svg class="grail__svg grail__svg--d" viewBox={`0 0 ${d.W} ${d.H}`} role="img" aria-label={grail.chartTitle}>
        <defs>
          <mask id="grail-trail" maskUnits="userSpaceOnUse">
            <path class="trail-mask" d={trailPath(d)} pathLength="1" />
          </mask>
        </defs>
        <g class="grid">
          {[1000, 2000].map((e) => <line x1={d.pad.l} x2={d.W - d.pad.r} y1={d.sy(e)} y2={d.sy(e)} />)}
        </g>
        <rect class="band" x={d.pad.l} width={d.W - d.pad.l - d.pad.r} y={d.sy(band.hi)} height={d.sy(band.lo) - d.sy(band.hi)}></rect>
        <text class="band-label" x={d.pad.l + 18} y={d.sy(band.hi) - 14}>
          {grail.chartBand[0]}
          <tspan dx="16">{grail.chartBand[1]}</tspan>
        </text>

        <path class="axis" d={`M${d.pad.l} ${d.pad.t} V${d.sy(0)} H${d.W - d.pad.r}`}></path>
        {
          [0, 1000, 2000].map((e) => (
            <text class="tick" x={d.pad.l - 14} y={d.sy(e) + 5} text-anchor="end">
              {e}
            </text>
          ))
        }
        {
          [1950, 1970, 1990, 2010, 2030].map((y) => (
            <text class="tick" x={d.sx(y)} y={d.H - d.pad.b + 30} text-anchor="middle">
              {y}
            </text>
          ))
        }
        <text class="axis-title" transform={`translate(26 ${(d.pad.t + d.sy(0)) / 2}) rotate(-90)`} text-anchor="middle">
          {grail.chartAxis}
        </text>

        {grailOthers.map((p) => <circle class="pt pt--other" cx={d.sx(p.year)} cy={d.sy(p.e)} r="6.5" style={delay(p.year)} />)}
        <path class="trail" d={trailPath(d)} mask="url(#grail-trail)"></path>
        {
          showJuna ? (
            <path class="juna-line" d={junaPath(d)} style={delay(2021)} />
          ) : (
            <g class="juna-dir" style={delay(2024)}>
              <path class="juna-dir__flat" d={`M${d.sx(last.year)} ${d.sy(last.e)} H${arrowX}`} />
              <path class="juna-dir__line" d={`M${arrowX} ${d.sy(last.e)} V${arrowTo}`} />
              <path class="juna-dir__head" d={`M${arrowX - 7} ${arrowTo - 10} L${arrowX} ${arrowTo} L${arrowX + 7} ${arrowTo - 10}`} />
              <text class="juna-dir__name" x={arrowX - 16} y={d.sy(last.e) + 34} text-anchor="end">
                JUNA
              </text>
              <text class="juna-dir__note" x={arrowX - 16} y={d.sy(last.e) + 56} text-anchor="end">
                {grail.chartJuna}
              </text>
            </g>
          )
        }
        {
          grailRecords.map((p) => {
            const [dx, dy, anchor] = place[p.who];
            return (
              <g class="rec" style={delay(p.year)}>
                <circle class="pt pt--rec" cx={d.sx(p.year)} cy={d.sy(p.e)} r="7.5" />
                <text class="rec-label" x={d.sx(p.year) + dx} y={d.sy(p.e) + dy} text-anchor={anchor}>
                  {`${p.who} ${p.year}`}
                  <tspan class="rec-e" dx="14">
                    {energy(p)}
                  </tspan>
                </text>
              </g>
            );
          })
        }
        {
          showJuna && (
            <g class="rec rec--juna" style={delay(2021)}>
              {grailJuna.map((p) => (
                <circle class:list={['pt', 'pt--rec', isPrelim(p.who) && 'pt--open']} cx={d.sx(p.year)} cy={d.sy(p.e)} r="7.5" />
              ))}
              <text class="rec-label" x={d.sx(2023.5)} y={d.sy(grailJuna[0].e) - 22} text-anchor="middle">
                JUNA
              </text>
            </g>
          )
        }
      </svg>
      {
        showJuna && (
          <p class="grail__key">
            {grailJuna.map((p) => (
              <span class:list={[isPrelim(p.who) && 'is-open']}>
                <i aria-hidden="true" />
                {p.who}
                <b>{energy(p)}</b>
                {isPrelim(p.who) && <em>{grail.chartPrelim}</em>}
              </span>
            ))}
          </p>
        )
      }

      <svg class="grail__svg grail__svg--m" viewBox={`0 0 ${m.W} ${m.H}`} role="img" aria-label={grail.chartTitle}>
        <defs>
          <mask id="grail-trail-m" maskUnits="userSpaceOnUse">
            <path class="trail-mask" d={trailPath(m)} pathLength="1" />
          </mask>
        </defs>
        <g class="grid">
          {[1000, 2000].map((e) => <line x1={m.pad.l} x2={m.W - m.pad.r} y1={m.sy(e)} y2={m.sy(e)} />)}
        </g>
        <rect class="band" x={m.pad.l} width={m.W - m.pad.l - m.pad.r} y={m.sy(band.hi)} height={m.sy(band.lo) - m.sy(band.hi)}></rect>
        <text class="band-label" x={m.pad.l + 8} y={m.sy(band.hi) - 8}>
          {grail.chartBand[0]}
          <tspan dx="8">{grail.chartBand[1]}</tspan>
        </text>
        <path class="axis" d={`M${m.pad.l} ${m.pad.t} V${m.sy(0)} H${m.W - m.pad.r}`}></path>
        <text class="tick" x={m.pad.l - 8} y={m.pad.t - 10} text-anchor="end">keV</text>
        {
          [0, 1000, 2000].map((e) => (
            <text class="tick" x={m.pad.l - 8} y={m.sy(e) + 4} text-anchor="end">
              {e}
            </text>
          ))
        }
        {
          [1950, 1990, 2030].map((y, i) => (
            <text class="tick" x={m.sx(y)} y={m.H - m.pad.b + 24} text-anchor={i === 2 ? 'end' : i ? 'middle' : 'start'}>
              {y}
            </text>
          ))
        }
        {grailOthers.map((p) => <circle class="pt pt--other" cx={m.sx(p.year)} cy={m.sy(p.e)} r="4.5" style={delay(p.year)} />)}
        <path class="trail" d={trailPath(m)} mask="url(#grail-trail-m)"></path>
        {showJuna && <path class="juna-line" d={junaPath(m)} style={delay(2021)} />}
        {
          grailRecords.map((p) => {
            const [dx, dy, anchor] = placeM[p.who];
            return (
              <g class="rec" style={delay(p.year)}>
                <circle class="pt pt--rec" cx={m.sx(p.year)} cy={m.sy(p.e)} r="5.5" />
                <text class="rec-year" x={m.sx(p.year) + dx} y={m.sy(p.e) + dy} text-anchor={anchor}>
                  {p.year}
                </text>
              </g>
            );
          })
        }
        {
          showJuna && (
            <g class="rec rec--juna" style={delay(2021)}>
              {grailJuna.map((p) => (
                <circle class:list={['pt', 'pt--rec', isPrelim(p.who) && 'pt--open']} cx={m.sx(p.year)} cy={m.sy(p.e)} r="5.5" />
              ))}
              <text class="rec-label rec-label--m" x={m.sx(2023.5)} y={m.sy(grailJuna[0].e) - 16} text-anchor="middle">
                JUNA
              </text>
            </g>
          )
        }
      </svg>

      <ol class="grail__list">
        {
          records.map((p) => (
            <li class:list={[p.who.startsWith('JUNA') && 'is-juna']}>
              <span class="grail__year">{p.year}</span>
              <span>{p.who.replace(/ \d+$/, '')}</span>
              <span class="grail__e">
                {energy(p)}
                {isPrelim(p.who) && <em>{grail.chartPrelim}</em>}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="grail__note"><T s={showJuna ? `${grail.chartNote}${grail.chartNoteJuna}` : grail.chartNote} /></p>
    </figure>

    <div class="grail__juna" data-reveal>
      <span class="label">JUNA</span>
      <p><T s={showJuna ? `${grail.junaPrelim} ${grail.juna}` : grail.juna} /></p>
    </div>

    <div class="gw" data-reveal>
      <div class="gw__art" aria-hidden="true">
        <svg viewBox="0 0 200 200">
          {[18, 34, 52, 72, 94].map((r, i) => <circle cx="100" cy="100" r={r} style={`--i:${i}`} />)}
          <circle class="gw__core" cx="92" cy="100" r="5"></circle>
          <circle class="gw__core" cx="108" cy="100" r="4"></circle>
        </svg>
      </div>
      <div>
        <h3 class="h3">{grail.gw.title}</h3>
        <p class="prose"><T s={grail.gw.body} /></p>
      </div>
    </div>
  </div>
</section>

<style>
  .grail__top {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: end;
    margin-bottom: clamp(3.5rem, 7vw, 6rem);
  }
  .grail__facts {
    margin: 0;
    border-top: 1px solid var(--line-strong);
  }
  .grail__facts div {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }
  .grail__facts dd {
    margin: 0 0 0.25rem;
    font-size: clamp(2.125rem, 2.9vw, 2.5rem);
    font-weight: 200;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--copper-light);
  }
  .grail__facts dt {
    font-size: 0.9062rem;
    color: var(--text-faint);
  }

  .grail__chart {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    background: var(--ink-900);
  }
  .grail__title {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    font-size: 1.0625rem;
    margin-bottom: 1.25rem;
  }
  .grail__title .label {
    flex: none;
    color: var(--copper);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grail__svg--m,
  .grail__list {
    display: none;
  }
  .grid line {
    stroke: var(--line);
  }
  .axis {
    fill: none;
    stroke: rgba(236, 238, 242, 0.6);
    stroke-width: 1.5;
  }
  .band {
    fill: rgba(194, 124, 78, 0.3);
  }
  .band-label {
    font-size: 17px;
    fill: var(--copper-light);
  }
  .tick {
    font-size: 14px;
    fill: var(--text-faint);
  }
  .axis-title {
    font-size: 15px;
    fill: var(--text-faint);
    letter-spacing: 0.04em;
  }
  .pt--other {
    fill: none;
    stroke: #8794a9;
    stroke-width: 1.6;
  }
  .pt--rec {
    fill: #d7dce5;
  }
  .rec-label {
    font-size: 18px;
    fill: var(--text);
  }
  .rec-e {
    fill: var(--text-dim);
  }
  .trail {
    fill: none;
    stroke: rgba(215, 220, 229, 0.6);
    stroke-width: 1.6;
    stroke-dasharray: 5 6;
  }
  .trail-mask {
    fill: none;
    stroke: #fff;
    stroke-width: 12;
  }
  .rec--juna .pt--rec {
    fill: var(--copper-light);
  }
  .rec--juna .pt--open {
    fill: var(--ink-900);
    stroke: var(--copper-light);
    stroke-width: 3;
  }
  .rec--juna .rec-label,
  .rec--juna .rec-e {
    fill: var(--copper-light);
    font-weight: 600;
  }
  .grail__key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 1.125rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.9062rem;
    color: var(--copper-light);
  }
  .grail__key span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
  }
  .grail__key i {
    align-self: center;
    width: 0.6875rem;
    height: 0.6875rem;
    border-radius: 50%;
    background: var(--copper-light);
  }
  .grail__key .is-open i {
    background: none;
    border: 2px solid var(--copper-light);
  }
  .grail__key b {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .grail__key em {
    font-style: normal;
    font-size: 0.8438rem;
    opacity: 0.8;
  }
  .rec-year {
    font-size: 12.5px;
    fill: var(--text-dim);
  }
  .grail__svg--m .tick {
    font-size: 12px;
  }
  .grail__svg--m .band-label {
    font-size: 12.5px;
  }
  .rec-label--m {
    font-size: 14px;
    letter-spacing: 0.06em;
  }
  .juna-line {
    fill: none;
    stroke: var(--copper-light);
    stroke-width: 2.5;
  }
  .juna-dir__flat {
    fill: none;
    stroke: rgba(215, 220, 229, 0.35);
    stroke-width: 1.6;
    stroke-dasharray: 5 6;
  }
  .juna-dir__line,
  .juna-dir__head {
    fill: none;
    stroke: var(--copper-light);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .juna-dir__name {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: 0.06em;
    fill: var(--copper-light);
  }
  .juna-dir__note {
    font-size: 15px;
    fill: var(--copper-light);
    opacity: 0.8;
  }
  .grail__note {
    margin: 1rem 0 0;
    font-size: 0.9062rem;
    color: var(--text-faint);
    max-width: 52em;
  }

  :global(.js) .grail__chart .pt,
  :global(.js) .grail__chart .rec,
  :global(.js) .grail__chart .juna-line,
  :global(.js) .grail__chart .juna-dir {
    opacity: 0;
    transition: opacity 0.6s ease;
    transition-delay: var(--t, 1.8s);
  }
  :global(.js) .grail__chart .trail-mask {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.6s linear 0.2s;
  }
  :global(.js) .grail__chart.is-in .pt,
  :global(.js) .grail__chart.is-in .rec,
  :global(.js) .grail__chart.is-in .juna-line,
  :global(.js) .grail__chart.is-in .juna-dir {
    opacity: 1;
  }
  :global(.js) .grail__chart.is-in .trail-mask {
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .grail__chart .pt,
    :global(.js) .grail__chart .rec,
    :global(.js) .grail__chart .juna-line,
    :global(.js) .grail__chart .juna-dir {
      opacity: 1;
      transition: none;
    }
    :global(.js) .grail__chart .trail-mask {
      stroke-dashoffset: 0;
      transition: none;
    }
  }

  .grail__juna {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 1.75rem 2rem;
    border: 1px solid rgba(194, 124, 78, 0.45);
    background: linear-gradient(90deg, var(--copper-glow), transparent 70%);
  }
  .grail__juna .label {
    color: var(--copper-light);
    padding-top: 0.25rem;
  }
  .grail__juna p {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 300;
  }

  .gw {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
    margin-top: clamp(4.5rem, 9vw, 8rem);
  }
  .gw__art {
    max-width: 20rem;
  }
  .gw__art circle {
    fill: none;
    stroke: var(--copper);
    stroke-width: 0.6;
    opacity: calc(1 - var(--i, 0) * 0.17);
    transform-origin: 6.25rem 6.25rem;
    animation: ripple 6s ease-in-out infinite;
    animation-delay: calc(var(--i, 0) * -0.6s);
  }
  .gw__art .gw__core {
    fill: var(--copper-light);
    stroke: none;
    opacity: 1;
    animation: none;
  }
  @keyframes ripple {
    0%,
    100% {
      transform: scale(0.96);
    }
    50% {
      transform: scale(1.04);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .gw__art circle {
      animation: none;
    }
  }

  @media (max-width: 960px) {
    .grail__top,
    .gw {
      grid-template-columns: minmax(0, 1fr);
    }
    .gw__art {
      max-width: 12.5rem;
    }
  }
  /* Phones: the taller drawing, with the records listed underneath. */
  @media (max-width: 760px) {
    .grail__svg--d,
    .grail__key {
      display: none;
    }
    .grail__svg--m {
      display: block;
      max-width: 28.75rem;
    }
    .grail__list {
      display: grid;
      margin: 1.25rem 0 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--line);
      font-size: 0.9375rem;
    }
    .grail__list li {
      display: grid;
      grid-template-columns: 3.4em minmax(0, 1fr) auto;
      gap: 0.75rem;
      align-items: baseline;
      padding: 0.5625rem 0;
      border-bottom: 1px solid var(--line);
      color: var(--text-dim);
    }
    .grail__year {
      font-size: 0.8125rem;
      color: var(--text-faint);
    }
    .grail__e {
      font-variant-numeric: tabular-nums;
      color: var(--text);
      white-space: nowrap;
    }
    .grail__e em {
      margin-left: 0.5rem;
      font-style: normal;
      font-size: 0.8125rem;
      color: var(--copper-light);
    }
    .grail__list li.is-juna,
    .grail__list li.is-juna .grail__e,
    .grail__list li.is-juna .grail__year {
      color: var(--copper-light);
    }
  }
  @media (max-width: 600px) {
    .grail__juna {
      grid-template-columns: minmax(0, 1fr);
