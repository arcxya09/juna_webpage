---
import { labs, type Content, type Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const { labs: copy } = t;
const max = Math.max(...labs.map((l) => l.depth));
const sorted = [...labs].sort((a, b) => a.depth - b.depth);
---

<section class="section section--deep labs" id="labs">
  <div class="wrap">
    <div class="head head--split">
      <div>
        <p class="kicker" data-reveal>{copy.kicker}</p>
        <h2 class="h2" data-reveal style="--d:.08s">{copy.title}</h2>
      </div>
      <p class="lead" data-reveal style="--d:.16s">{copy.body}</p>
    </div>

    <div class="chart" data-reveal="fade">
      <div class="chart__axis" aria-hidden="true">
        <span class="label">{copy.depthLabel}</span>
        {[0, 600, 1200, 1800, 2400].map((d) => <i style={`--k:${d / max}`}>{d ? `−${d}` : '0'} m</i>)}
      </div>
      <ol class="chart__labs">
        {
          sorted.map((l, i) => (
            <li class:list={['lab', l.accel && 'is-accel', l.name === 'CJPL' && 'is-juna']} style={`--k:${l.depth / max};--i:${i}`}>
              <span class="lab__head">
                <b>{l.name}</b>
                <small>{l.country[lang]}</small>
              </span>
              <span class="lab__track">
                <span class="lab__bar" />
                <span class="lab__depth">{l.depth}</span>
              </span>
              {l.accel && <span class="lab__accel">{l.accel}</span>}
            </li>
          ))
        }
      </ol>
    </div>
    <div class="labs__foot">
      <p class="labs__legend"><i></i>{copy.legend}</p>
    </div>
  </div>
</section>

<style>
  .chart {
    --h: 23.75rem;
    position: relative;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
  }
  .chart__axis {
    position: relative;
    margin-top: 3.875rem;
    height: var(--h);
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  .chart__axis .label {
    position: absolute;
    top: -3.5rem;
    left: 0;
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .chart__axis i {
    position: absolute;
    right: 0;
    top: calc(var(--k) * 100%);
    transform: translateY(-50%);
    font-style: normal;
    white-space: nowrap;
  }
  .chart__labs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(13, minmax(0, 1fr));
    gap: 0.375rem;
    background:
      repeating-linear-gradient(180deg, transparent 0 calc(var(--h) / 4 - 1px), var(--line) calc(var(--h) / 4 - 1px) calc(var(--h) / 4)) 0 3.875rem / 100% var(--h) no-repeat;
  }
  .lab {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .lab__head {
    height: 3.875rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--line-strong);
    font-size: 0.8438rem;
    line-height: 1.3;
  }
  .lab__head b {
    font-weight: 500;
    font-size: 0.8125rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .lab__head small {
    font-size: 0.7812rem;
    color: var(--text-faint);
  }
  .lab__track {
    position: relative;
    height: var(--h);
  }
  .lab__bar {
    position: absolute;
    left: 0;
    width: min(2.125rem, 70%);
    top: 0;
    height: calc(var(--k) * 100%);
    background: linear-gradient(180deg, rgba(127, 156, 199, 0.08), rgba(127, 156, 199, 0.4));
    border-bottom: 1px solid #7f9cc7;
    transform-origin: 50% 0;
    transition: transform 1.4s var(--ease) calc(var(--i) * 0.05s);
  }
  .lab__depth {
    position: absolute;
    left: 0;
    top: calc(var(--k) * 100% + 0.5rem);
    font-size: 0.7812rem;
    color: var(--text-dim);
    transition: opacity 0.6s ease calc(0.8s + var(--i) * 0.05s);
  }
  .is-accel .lab__bar {
    background: linear-gradient(180deg, rgba(194, 124, 78, 0.12), rgba(194, 124, 78, 0.65));
    border-bottom-color: var(--copper-light);
  }
  .is-accel .lab__head b,
  .is-accel .lab__depth {
    color: var(--copper-light);
  }
  .is-juna .lab__bar {
    background: linear-gradient(180deg, rgba(227, 171, 128, 0.2), var(--copper));
    box-shadow: 0 1.125rem 2.5rem -0.625rem rgba(194, 124, 78, 0.6);
  }
  .lab__accel {
    position: absolute;
    left: 0;
    top: calc(3.875rem + var(--k) * var(--h) + 1.75rem);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    padding: 2px 0.375rem;
    border: 1px solid var(--copper);
    background: var(--ink-950);
    color: var(--copper-light);
    white-space: nowrap;
    z-index: 1;
  }
  .is-juna .lab__accel {
    background: var(--copper);
    color: var(--ink-950);
  }
  .is-juna .lab__accel,
  .is-juna .lab__depth {
    top: auto;
  }
  .is-juna .lab__depth {
    top: calc(100% + 0.5rem);
  }
  .is-juna .lab__accel {
    top: calc(3.875rem + var(--h) + 1.75rem);
  }
  :global(.js) .lab__bar {
    transform: scaleY(0);
  }
  :global(.js) .lab__depth {
    opacity: 0;
  }
  :global(.js) .is-in .lab__bar {
    transform: none;
  }
  :global(.js) .is-in .lab__depth {
    opacity: 1;
  }

  .labs__foot {
    margin-top: 4.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    align-items: baseline;
  }
  .labs__legend {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 0.875rem;
    color: var(--text-dim);
    margin: 0;
  }
  .labs__legend i {
    width: 0.875rem;
    height: 0.875rem;
    background: var(--copper);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .lab__bar {
      transform: none;
    }
    :global(.js) .lab__depth {
      opacity: 1;
    }
  }

  /* Narrow screens: horizontal bars, one laboratory per row. */
  @media (max-width: 1120px) {
    .chart {
      grid-template-columns: minmax(0, 1fr);
    }
    .chart__axis {
      display: none;
    }
    .chart__labs {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      background: none;
      border-top: 1px solid var(--line-strong);
    }
    .lab {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid var(--line);
    }
    .lab__head {
      height: auto;
      border: 0;
      padding: 0;
    }
    .lab__track {
      height: 0.875rem;
    }
    .lab__bar {
      top: 0;
      bottom: 0;
      height: auto;
      width: calc(var(--k) * 58%);
      transform-origin: 0 50%;
      border-bottom: 0;
      border-right: 1px solid #7f9cc7;
      background: linear-gradient(90deg, rgba(127, 156, 199, 0.08), rgba(127, 156, 199, 0.45));
    }
    .is-accel .lab__bar {
      background: linear-gradient(90deg, rgba(194, 124, 78, 0.12), rgba(194, 124, 78, 0.7));
      border-right-color: var(--copper-light);
    }
    .is-juna .lab__bar {
      background: linear-gradient(90deg, rgba(227, 171, 128, 0.2), var(--copper));
    }
    :global(.js) .lab__bar {
      transform: scaleX(0);
    }
    .lab__depth,
    .is-juna .lab__depth {
      top: 50%;
      left: calc(var(--k) * 58% + 0.5rem);
      transform: translateY(-50%);
    }
    .lab__accel,
    .is-juna .lab__accel {
      position: absolute;
      top: 50%;
      left: auto;
      right: 0;
      transform: translateY(-50%);
    }
    .labs__foot {
      margin-top: 1.75rem;
    }
  }
</style>
