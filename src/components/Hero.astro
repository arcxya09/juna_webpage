---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero" id="top">
  <div class="hero__bg" data-parallax="0.35" style={`background-image:url(${base}/images/hero-space.jpg)`}></div>
  <canvas class="hero__canvas" data-particles aria-hidden="true"></canvas>
  <div class="hero__shade"></div>
  <div class="wrap hero__content">
    <p class="hero__eyebrow" data-reveal>{t.hero.eyebrow}</p>
    <h1 class="hero__title" data-reveal style="--d:.12s">
      {t.hero.title.split('\n').map((line) => <span>{line}</span>)}
    </h1>
    <p class="hero__lead" data-reveal style="--d:.24s">{t.hero.lead}</p>
    <div class="hero__actions" data-reveal style="--d:.36s">
      <a class="btn btn--solid" href="#mission">{t.hero.cta}</a>
      <a class="btn" href="#results">{t.hero.cta2}</a>
    </div>
  </div>
  <a class="hero__scroll" href="#mission">
    <span>{t.hero.scroll}</span>
    <i></i>
  </a>
  <div class="hero__coords" aria-hidden="true">
    <span>28.15°N 101.71°E</span>
    <span>−2400 m</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--ink-950);
  }
  .hero__bg {
    position: absolute;
    inset: -10% 0;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(5, 9, 15, 0.85) 0%, rgba(5, 9, 15, 0.35) 55%, rgba(5, 9, 15, 0.1) 100%),
      linear-gradient(0deg, var(--ink-900) 0%, rgba(10, 18, 32, 0) 30%);
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: var(--nav-h);
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--copper-light);
    margin: 0 0 28px;
  }
  .hero__title {
    margin: 0 0 32px;
    font-size: clamp(40px, 7vw, 96px);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  :global(html[lang='zh-CN']) .hero__title {
    font-weight: 400;
    letter-spacing: 0.04em;
    line-height: 1.2;
  }
  .hero__title span {
    display: block;
  }
  .hero__lead {
    max-width: 38em;
    font-size: clamp(16px, 1.4vw, 19px);
    color: var(--text-dim);
    font-weight: 300;
    margin: 0 0 44px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hero__scroll {
    position: absolute;
    left: 50%;
    bottom: 32px;
    transform: translateX(-50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .hero__scroll i {
    width: 1px;
    height: 48px;
    background: linear-gradient(var(--copper), transparent);
    animation: drip 2.4s ease-in-out infinite;
    transform-origin: top;
  }
  @keyframes drip {
    0% { transform: scaleY(0); opacity: 1; }
    60% { transform: scaleY(1); opacity: 1; }
    100% { transform: scaleY(1); opacity: 0; }
  }
  .hero__coords {
    position: absolute;
    right: var(--gutter);
    bottom: 36px;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }
  @media (max-width: 720px) {
    .hero__coords {
      display: none;
    }
    .hero__shade {
      background:
        linear-gradient(0deg, var(--ink-900) 0%, rgba(5, 9, 15, 0.55) 60%, rgba(5, 9, 15, 0.4) 100%);
    }
  }
</style>
