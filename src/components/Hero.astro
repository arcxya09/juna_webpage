---
import { Image } from 'astro:assets';
import type { Content, Lang } from '../i18n/content';
import { img, widths } from '../lib/img';
import { href } from '../lib/routes';
import T from './T.astro';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const photo = img('hero-accelerator.jpg');
const lines = t.hero.title.split('\n');
---

<section class="hero">
  <div class="hero__media" data-parallax="0.22">
    <Image
      class="hero__img"
      src={photo}
      alt={t.hero.caption}
      widths={widths(photo)}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>
  <canvas class="hero__canvas" data-particles aria-hidden="true"></canvas>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="wrap hero__content">
    <h1 class="hero__title">
      {
        lines.map((line, i) => (
          <span class="hero__line">
            <span style={`--i:${i + 1}`}>{line}</span>
          </span>
        ))
      }
    </h1>
    <p class="hero__lead hero__in" style={`--i:${lines.length + 1}`}>{t.hero.lead}</p>
    <div class="hero__actions hero__in" style={`--i:${lines.length + 2}`}>
      <a class="btn btn--solid" href={href(lang, 'science')}>{t.hero.cta}</a>
      <a class="btn" href={href(lang, 'results')}>{t.hero.cta2}</a>
    </div>
  </div>

  <div class="hero__foot">
    <div class="wrap">
      <dl class="hero__stats">
        {
          t.hero.stats.map((s, i) => (
            <div class="hero__stat hero__in" style={`--i:${lines.length + 3 + i * 0.5}`}>
              <dt>{s.label}</dt>
              <dd>
                <span class="hero__value" data-count={/^\d+$/.test(s.value) ? s.value : undefined}>
                  <T s={s.value} />
                </span>
                {s.unit && (
                  <span class="hero__unit">
                    <T s={s.unit} />
                  </span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="hero__caption">
        <span>CJPL · −2400 m</span>
        <span>{t.hero.caption}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: var(--ink-950);
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: -6% 0;
    will-change: transform;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 58% 55%;
    filter: saturate(0.82) contrast(1.05);
  }
  :global(.js) .hero__img {
    animation: kenburns 22s cubic-bezier(0.2, 0.6, 0.3, 1) both;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.14);
    }
    to {
      transform: scale(1.02);
    }
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    mix-blend-mode: screen;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(4, 8, 14, 0.92) 0%, rgba(4, 8, 14, 0.7) 32%, rgba(4, 8, 14, 0.15) 70%, rgba(4, 8, 14, 0.25) 100%),
      linear-gradient(0deg, rgba(4, 8, 14, 0.96) 0%, rgba(4, 8, 14, 0.4) 30%, rgba(4, 8, 14, 0) 55%),
      linear-gradient(180deg, rgba(4, 8, 14, 0.6) 0%, rgba(4, 8, 14, 0) 22%);
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    padding-top: calc(var(--nav-h) + 48px);
    padding-bottom: clamp(40px, 7vh, 88px);
  }
  .hero__title {
    margin: 0 0 32px;
    font-size: clamp(42px, 5.8vw, 88px);
    line-height: 1.04;
    font-weight: 250;
    letter-spacing: -0.035em;
  }
  :global(html[lang='zh-CN']) .hero__title {
    font-weight: 300;
    letter-spacing: 0.04em;
    line-height: 1.22;
    font-size: clamp(40px, 6.6vw, 92px);
  }
  .hero__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  .hero__line > span {
    display: block;
  }
  .hero__lead {
    max-width: 36em;
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.75;
    color: rgba(236, 238, 242, 0.78);
    font-weight: 300;
    margin: 0 0 40px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .hero__foot {
    position: relative;
    z-index: 2;
    border-top: 1px solid var(--line);
    background: linear-gradient(0deg, rgba(4, 8, 14, 0.6), rgba(4, 8, 14, 0));
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .hero__stat {
    padding: 26px 24px 22px 0;
    display: flex;
    flex-direction: column-reverse;
    gap: 8px;
  }
  .hero__stat + .hero__stat {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }
  .hero__stat dt {
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-faint);
  }
  .hero__stat dd {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    white-space: nowrap;
  }
  .hero__value {
    font-size: clamp(26px, 2.6vw, 38px);
    font-weight: 250;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .hero__unit {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--copper-light);
  }
  .hero__caption {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin: 0;
    padding: 12px 0 18px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  /* Entrance: lines rise out of their masks, the rest fades up. */
  :global(.js) .hero__line > span {
    animation: rise 1.2s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(0.25s + var(--i) * 0.12s);
  }
  :global(.js) .hero__in {
    animation: fadeup 1.1s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(0.25s + var(--i) * 0.12s);
  }
  @keyframes rise {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }
  @keyframes fadeup {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__img,
    :global(.js) .hero__line > span,
    :global(.js) .hero__in {
      animation: none;
    }
  }

  @media (max-width: 860px) {
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__stat + .hero__stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .hero__stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .hero__caption span:first-child {
      display: none;
    }
  }
  @media (max-width: 720px) {
    .hero__shade {
      background:
        linear-gradient(0deg, rgba(4, 8, 14, 0.97) 0%, rgba(4, 8, 14, 0.75) 45%, rgba(4, 8, 14, 0.35) 75%, rgba(4, 8, 14, 0.55) 100%);
    }
    .hero__img {
      object-position: 50% 50%;
    }
    .hero__content {
      padding-top: calc(var(--nav-h) + 96px);
    }
    .hero__stat {
      padding-top: 18px;
      padding-bottom: 16px;
    }
    .hero__stat + .hero__stat:nth-child(even) {
      padding-left: 16px;
    }
    .hero__stat dd {
      flex-wrap: wrap;
      column-gap: 6px;
      row-gap: 0;
    }
  }
  @media (max-width: 560px) {
    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 12px;
    }
    .hero__actions .btn {
      justify-content: space-between;
    }
  }
</style>
