---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const thumbs = ['hero-space', 'beamline', 'detector'];
---

<section class="section news" id="news">
  <div class="wrap">
    <p class="kicker" data-reveal>{t.news.kicker}</p>
    <h2 class="h2" data-reveal style="--d:.1s">{t.news.title}</h2>
    <div class="news__grid">
      {
        t.news.items.map((n, i) => (
          <article class="news__card" data-reveal style={`--d:${i * 0.1}s`}>
            <div class="news__thumb" style={`background-image:url(${base}/images/${thumbs[i % thumbs.length]}.jpg)`} />
            <div class="news__meta">
              <time>{n.date}</time>
              <span>{n.tag}</span>
              {n.verify && <span class="verify">{t.results.verifyNote}</span>}
            </div>
            <h3>{n.title}</h3>
          </article>
        ))
      }
    </div>
    <p class="news__more" data-reveal>{t.news.more}</p>
  </div>
</section>

<style>
  .news {
    background: var(--ink-850);
  }
  .news__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: clamp(40px, 5vw, 64px);
  }
  .news__card {
    border-top: 1px solid var(--line-strong);
    padding-top: 0;
  }
  .news__thumb {
    aspect-ratio: 16 / 10;
    background-size: cover;
    background-position: center;
    filter: saturate(0.8);
    transition: filter 0.4s, transform 0.6s;
  }
  .news__card:hover .news__thumb {
    filter: saturate(1.1) brightness(1.1);
  }
  .news__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
    margin: 20px 0 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .news__meta span:first-of-type {
    color: var(--copper-light);
    text-transform: uppercase;
  }
  .news__card h3 {
    margin: 0;
    font-size: 19px;
    font-weight: 400;
    line-height: 1.45;
  }
  .news__more {
    margin: 48px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  @media (max-width: 860px) {
    .news__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
