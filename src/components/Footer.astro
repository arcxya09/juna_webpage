---
import type { Content, Lang } from '../i18n/content';
import { CHAPTERS, href, type PageKey } from '../lib/routes';

interface Props {
  t: Content;
  lang: Lang;
  page: PageKey;
}

const { t, lang, page } = Astro.props;
const otherHref = href(lang === 'zh' ? 'en' : 'zh', page);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <p class="footer__brand">
        <span>{t.footer.line}</span>
        <span>{t.footer.org}</span>
      </p>
      <nav class="footer__nav" aria-label="Footer">
        {CHAPTERS.map((k) => <a href={href(lang, k)}>{t.nav[k]}</a>)}
      </nav>
    </div>
    <div class="footer__bottom">
      <p>{t.footer.note}</p>
      <p class="footer__tools">
        <a href={otherHref}>{t.nav.switchLabel}</a>
        <a href="#top">{t.footer.top} ↑</a>
        <span>© {year} JUNA</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-950);
    border-top: 1px solid var(--line);
    padding: 4.5rem 0 2.5rem;
    font-size: 0.9375rem;
    color: var(--text-faint);
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
  }
  .footer__brand span:first-child {
    color: var(--text);
    font-size: 0.9375rem;
  }
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(5, auto);
    gap: 0.75rem 2.5rem;
    align-content: start;
  }
  .footer__nav a,
  .footer__tools a {
    transition: color 0.2s;
  }
  .footer__nav a:hover,
  .footer__tools a:hover {
    color: var(--copper-light);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2.5rem;
    padding-top: 1.75rem;
    font-size: 0.875rem;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__tools {
    display: flex;
    gap: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }
  @media (max-width: 600px) {
    .footer__nav {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
