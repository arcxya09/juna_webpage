---
import type { Content, Lang } from '../i18n/content';

interface Props {
  t: Content;
  lang: Lang;
}

const { t, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const otherHref = lang === 'zh' ? `${base}/en/` : `${base}/`;
const year = new Date().getFullYear();
const links = ['science', 'underground', 'platform', 'history', 'results', 'future', 'team'] as const;
---

<footer class="footer">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img
          src={`${base}/brand/juna-banner-dark.svg`}
          alt="JUNA 锦屏深地核天体物理实验 Jinping Underground Nuclear Astrophysics Experiment"
          width="430"
          height="60"
          loading="lazy"
        />
        <p>
          <span>{t.footer.line}</span>
          <span>{t.footer.org}</span>
        </p>
      </div>
      <nav class="footer__nav" aria-label="Footer">
        {links.map((k) => <a href={`#${k}`}>{t.nav[k]}</a>)}
      </nav>
    </div>
    <div class="footer__bottom">
      <p>{t.footer.note}</p>
      <p class="footer__tools">
        <a href={otherHref}>{t.nav.switchLabel}</a>
        <a href="#top">{t.footer.top} ↑</a>
        <span>© {year} JUNA</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink-950);
    border-top: 1px solid var(--line);
    padding: 72px 0 40px;
    font-size: 14px;
    color: var(--text-faint);
  }
  .footer__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--line);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 100%;
  }
  .footer__brand img {
    width: 430px;
    max-width: 100%;
    height: auto;
  }
  .footer__brand p {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
  }
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(4, auto);
    gap: 12px 40px;
    align-content: start;
  }
  .footer__nav a,
  .footer__tools a {
    transition: color 0.2s;
  }
  .footer__nav a:hover,
  .footer__tools a:hover {
    color: var(--copper-light);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 40px;
    padding-top: 28px;
    font-size: 13px;
  }
  .footer__bottom p {
    margin: 0;
  }
  .footer__tools {
    display: flex;
    gap: 28px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  @media (max-width: 600px) {
    .footer__nav {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
