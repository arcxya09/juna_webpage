---
import type { Content } from '../i18n/content';

interface Props {
  t: Content;
}

const { t } = Astro.props;
---

<section class="section numbers" id="numbers">
  <div class="wrap">
    <p class="kicker" data-reveal>{t.numbers.kicker}</p>
    <h2 class="h2" data-reveal style="--d:.1s">{t.numbers.title}</h2>
    <dl class="numbers__grid">
      {
        t.numbers.items.map((n, i) => (
          <div class="numbers__item" data-reveal style={`--d:${i * 0.1}s`}>
            <dt>
              <span class="numbers__value" data-count={n.value}>{n.value.toLocaleString('en-US')}</span>
              <span class="numbers__unit">{n.suffix}{n.unit}</span>
            </dt>
            <dd>{n.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .numbers {
    background: var(--ink-850);
  }
  .numbers__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(48px, 6vw, 80px) 0 0;
  }
  .numbers__item {
    padding: 8px 24px 8px 0;
    border-left: 1px solid var(--line);
    padding-left: 24px;
  }
  .numbers__item:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .numbers__item dt {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .numbers__value {
    font-size: clamp(48px, 6vw, 88px);
    font-weight: 200;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .numbers__unit {
    font-family: var(--font-mono);
    font-size: 16px;
    color: var(--copper-light);
  }
  .numbers__item dd {
    margin: 18px 0 0;
    color: var(--text-dim);
    font-size: 15px;
    max-width: 16em;
  }
  @media (max-width: 860px) {
    .numbers__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 48px;
    }
    .numbers__item:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }
</style>
