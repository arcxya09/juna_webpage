---
// Full-bleed cover that opens each chapter page, followed by a sticky bar
// listing the sections on the page.
import { Image } from 'astro:assets';
import type { Content } from '../i18n/content';
import { img, widths } from '../lib/img';
import { CHAPTERS, COVERS, type Chapter } from '../lib/routes';
import T from './T.astro';

interface Props {
  t: Content;
  page: Chapter;
}

const { t, page } = Astro.props;
const ch = t.chapters[page];
const cover = COVERS[page];
const photo = img(cover.image);
const sections = t.sections[page];
---

<header class="ph">
  <div class="ph__media" data-parallax="0.2">
    <Image
      class="ph__img"
      src={photo}
      alt=""
      widths={widths(photo)}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      style={`object-position:${cover.pos}`}
    />
  </div>
  <div class="ph__shade" aria-hidden="true"></div>
  <span class="ph__num" aria-hidden="true" data-parallax="-0.08">{ch.num}</span>

  <div class="wrap ph__inner">
    <p class="kicker ph__in" style="--i:0">
      <span>{ch.label}</span>
      <span class="ph__count">{ch.num} / {String(CHAPTERS.length).padStart(2, '0')}</span>
    </p>
    <h1 class="ph__title">
      <span class="ph__line"><span style="--i:1"><T s={ch.title} /></span></span>
    </h1>
    <p class="lead ph__lead ph__in" style="--i:2"><T s={ch.body} /></p>
  </div>
  <a class="ph__scroll ph__in" style="--i:3" href={`#${sections[0][0]}`} aria-label={t.pageNav.scroll}>
    <span>{t.pageNav.scroll}</span>
    <i aria-hidden="true"></i>
  </a>
</header>

<nav class="subnav" data-subnav aria-label={t.pageNav.onPage}>
  <div class="wrap subnav__inner">
    <span class="subnav__title"><b>{ch.num}</b>{t.nav[page]}</span>
    <div class="subnav__links">
      {
        sections.map(([id, label], i) => (
          <a href={`#${id}`}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            {label}
          </a>
        ))
      }
    </div>
  </div>
</nav>

<style>
  .ph {
    position: relative;
    min-height: min(100svh, 62.5rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink-950);
    isolation: isolate;
  }
  .ph__media {
    position: absolute;
    inset: -10% 0;
    will-change: transform;
  }
  .ph__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.04);
  }
  :global(.js) .ph__img {
    animation: ph-zoom 2.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes ph-zoom {
    from {
      transform: scale(1.16);
      filter: saturate(0.4) brightness(0.6);
    }
  }
  .ph__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, var(--ink-900) 0%, rgba(8, 16, 28, 0.82) 22%, rgba(8, 16, 28, 0.2) 62%, rgba(8, 16, 28, 0.6) 100%),
      linear-gradient(90deg, rgba(4, 8, 14, 0.7), rgba(4, 8, 14, 0) 65%);
  }
  .ph__num {
    position: absolute;
    right: calc(var(--edge) - 0.04em);
    top: calc(var(--nav-h) + 4vh);
    font-size: clamp(10rem, 28vw, 27.5rem);
    line-height: 0.8;
    font-weight: 100;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(227, 171, 128, 0.55);
    font-variant-numeric: tabular-nums;
    user-select: none;
    pointer-events: none;
  }
  :global(.js) .ph__num {
    animation: ph-num 2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.3s both;
  }
  @keyframes ph-num {
    from {
      opacity: 0;
      letter-spacing: 0.08em;
    }
  }
  .ph__inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-h) + 7.5rem);
    padding-bottom: clamp(7.5rem, 15vh, 10.5rem);
  }
  .ph .kicker {
    gap: 0.875rem;
  }
  .ph__count {
    color: var(--text-faint);
  }
  .ph__count::before {
    content: '';
    display: inline-block;
    vertical-align: middle;
    width: 1.125rem;
    height: 1px;
    margin-right: 0.875rem;
    background: var(--line-strong);
  }
  .ph__title {
    margin: 0 0 1.75rem;
    font-size: clamp(2.75rem, 7.2vw, 7rem);
    line-height: 1.02;
    font-weight: 250;
    letter-spacing: -0.035em;
    max-width: 14em;
  }
  :global(html[lang='zh-CN']) .ph__title {
    font-weight: 300;
    letter-spacing: 0.03em;
    line-height: 1.18;
  }
  .ph__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .ph__line > span {
    display: block;
  }
  .ph__lead {
    max-width: 36em;
    color: rgba(236, 238, 242, 0.8);
  }
  .ph__scroll {
    position: absolute;
    z-index: 1;
    right: var(--edge);
    bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-faint);
  }
  .ph__scroll i {
    position: relative;
    width: 1px;
    height: 3.5rem;
    background: var(--line-strong);
    overflow: hidden;
  }
  .ph__scroll i::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 40%;
    background: var(--copper-light);
    animation: drip 2.2s cubic-bezier(0.6, 0, 0.3, 1) infinite;
  }
  @keyframes drip {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(260%);
    }
  }

  :global(.js) .ph__line > span {
    animation: ph-rise 1.3s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(0.2s + var(--i) * 0.12s);
  }
  :global(.js) .ph__in {
    animation: ph-fade 1.1s cubic-bezier(0.2, 0.75, 0.2, 1) both;
    animation-delay: calc(0.3s + var(--i) * 0.14s);
  }
  @keyframes ph-rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes ph-fade {
    from {
      opacity: 0;
      transform: translateY(1.125rem);
    }
  }

  .subnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: rgba(8, 16, 28, 0.95);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    transition: top 0.45s var(--ease);
  }
  :global(.nav.is-tucked ~ main) .subnav {
    top: 0;
  }
  .subnav__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 3.375rem;
  }
  .subnav__title {
    flex: none;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .subnav__title b {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.6875rem;
    color: var(--copper);
  }
  .subnav__links {
    display: flex;
    gap: 0.375rem;
    margin-left: auto;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav__links::-webkit-scrollbar {
    display: none;
  }
  .subnav__links a {
    flex: none;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4375rem 0.875rem;
    font-size: 0.8438rem;
    color: var(--text-dim);
    border: 1px solid transparent;
    border-radius: 62.4375rem;
    transition: color 0.25s, border-color 0.25s, background 0.25s;
  }
  .subnav__links a span {
    font-family: var(--font-mono);
    font-size: 0.6562rem;
    color: var(--text-faint);
    transition: color 0.25s;
  }
  .subnav__links a:hover {
    color: var(--text);
  }
  .subnav__links a.is-active {
    color: var(--text);
    border-color: rgba(194, 124, 78, 0.5);
    background: var(--copper-glow);
  }
  .subnav__links a.is-active span {
    color: var(--copper-light);
  }

  @media (max-width: 720px) {
    .ph {
      min-height: 92svh;
    }
    .ph__num {
      top: calc(var(--nav-h) + 1.5rem);
      font-size: 46vw;
    }
    .ph__shade {
      background: linear-gradient(0deg, var(--ink-900) 0%, rgba(8, 16, 28, 0.85) 40%, rgba(8, 16, 28, 0.35) 75%, rgba(8, 16, 28, 0.6) 100%);
    }
    .ph__scroll {
      display: none;
    }
    .ph__inner {
      padding-bottom: 3.5rem;
    }
    .subnav__inner {
      gap: 0.75rem;
    }
    .subnav__title {
      display: none;
    }
    .subnav__links {
      margin-left: calc(-1 * var(--gutter));
      margin-right: calc(-1 * var(--gutter));
      padding: 0 var(--gutter);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .ph__img,
    :global(.js) .ph__num,
    :global(.js) .ph__line > span,
    :global(.js) .ph__in {
      animation: none;
    }
    .ph__scroll i::after {
      animation: none;
    }
  }
</style>
